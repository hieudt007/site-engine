{
  "name": "web-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --exclude themes --exclude uploads --exclude debug-ai --env-file=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migrate:encrypt-agent-keys": "tsx scripts/migrate-encrypt-agent-keys.ts",
    "release": "bash scripts/build-release.sh",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "audit:security": "npm audit --omit=dev --audit-level=high",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@fastify/view": "^11.0.0",
    "@node-oauth/oauth2-server": "^5.3.0",
    "@prisma/client": "^6.2.1",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "clean-css": "^5.3.3",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.2.1",
    "file-type": "^22.0.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "liquidjs": "^10.21.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "terser": "^5.49.0",
    "turndown": "^7.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/clean-css": "^4.2.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "prisma": {
    "seed": "node dist/seedAgents.js && node dist/seedSiteConfig.js"
  }
}
