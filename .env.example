PORT=3040
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/site_engine_dev

SITE_ENGINE_SECRET=dev-secret-change-me
LEADBASE_API_URL=http://localhost:8000
LEADBASE_OAUTH_CLIENT_ID=dev-oauth-client-id

SESSION_SECRET=dev-session-secret-change-me-32chars-minimum
CUSTOMER_SESSION_SECRET=dev-customer-session-secret-change-me

# 32 byte base64 - generate: node -e "console.log('base64:' + require('crypto').randomBytes(32).toString('base64'))"
NODE_ENCRYPTION_KEY=

SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
REDIS_URL=redis://127.0.0.1:6379

# Bat len (true) neu khong co Redis chay o moi truong local/test - CacheService se dung mock
# thay vi ket noi that, tranh ioredis retry toi 20 lan/request roi moi bo cuoc (khien MOI thao
# tac luu bai viet/san pham/danh muc bi treo rat lau du van thanh cong). Giong het pattern
# DISABLE_QUEUE cua lead-base-node. KHONG bat o production.
DISABLE_QUEUE=false

# Chi can khai bao neu VPS chay NHIEU site-engine instance dung chung 1 REDIS_URL (mac dinh cua
# provisioning flow, xem lead-base-node's siteEngineProvision.ts) - moi instance PHAI co gia tri
# KHAC NHAU (VD ten DB cua chinh site do) de tranh doc/ghi de len cache cua nhau qua CacheService.
# Bo trong (mac dinh "default") neu chi chay 1 instance duy nhat (local dev, hoac 1 site/VPS).
SITE_ENGINE_INSTANCE_ID=