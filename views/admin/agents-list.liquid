{% layout "layout" %}
{% block content %}
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.2rem;">
  <h1 style="margin:0;">AI Agent</h1>
  <a class="btn btn-primary" href="/admin/agents/new">{% render "components/icon", name: "plus" %}<span>Agent mới</span></a>
</div>
<p style="color:#777;font-size:0.85rem;margin-top:-0.8rem;margin-bottom:1.2rem;">
  Cấu hình nhà cung cấp AI + API key. Agent có "Key" sẽ tự động dùng cho các tính năng hệ thống tương ứng (vd: design, chat). Agent hệ thống không thể bị xoá.
</p>

<div id="agents-grid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(300px, 1fr));gap:1.5rem;">
  <div style="color:#999;grid-column:1/-1;">Đang tải...</div>
</div>

<div style="display:flex;justify-content:space-between;align-items:center;margin-top:2.5rem; padding-top:2rem; border-top: 1px solid #e5e7eb;">
  <h2 style="margin:0; font-size:1.4rem;">Skill (Bí kíp)</h2>
  <a class="btn btn-primary" href="/admin/agents/new?type=skill">{% render "components/icon", name: "plus" %}<span>Skill mới</span></a>
</div>
<p style="color:#777;font-size:0.85rem;margin-top:0.4rem;margin-bottom:1.2rem;">
  Hướng dẫn/kỹ năng chuyên sâu mà Agent có thể gọi ra khi cần (vd cách dựng 1 loại section cụ thể). Gán Skill cho Agent nào ở trang cấu hình Agent đó.
</p>

<div id="skills-grid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(300px, 1fr));gap:1.5rem;">
  <div style="color:#999;grid-column:1/-1;">Đang tải...</div>
</div>

<h2 style="margin-top:2.5rem; margin-bottom:1.2rem; font-size:1.4rem; padding-top:2rem; border-top: 1px solid #e5e7eb;">
  Công cụ hỗ trợ (Tools)
</h2>
<p style="color:#777;font-size:0.85rem;margin-top:-0.8rem;margin-bottom:1.2rem;">
  Các công cụ kỹ thuật được lập trình sẵn trong hệ thống để Agent có thể sử dụng. Tool không thể tự tạo qua giao diện.
</p>

<div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(300px, 1fr));gap:1.5rem;">
  {% for tool in allTools %}
  <div class="card" style="padding:1rem; display:flex; flex-direction:column; gap:0.5rem;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
      <h3 style="margin:0; font-size:1rem; display:flex; align-items:center;">
        <svg class="admin-icon" style="width:18px;height:18px;margin-right:0.4rem;color:var(--color-primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        {{ tool.name | escape }}
      </h3>
      <button class="btn btn-icon" style="color:#9ca3af;" title="Cấu hình (Code-based)" onclick="alert('Công cụ này được lập trình cứng trong code, không thể cấu hình qua giao diện.');">
        <svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      </button>
    </div>
    <div style="font-size:0.85rem; color:#6b7280; line-height:1.4; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;" title="{{ tool.description | escape }}">
      {{ tool.description | escape }}
    </div>
  </div>
  {% else %}
  <div class="empty-state" style="grid-column:1/-1;">Chưa có tool nào được lập trình.</div>
  {% endfor %}
</div>

<script>
(function () {
  const flash = document.getElementById("flash");

  function showError(message) {
    flash.textContent = message;
    flash.className = "error";
  }

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = str ?? "";
    return div.innerHTML;
  }

  function rowHtml(agent) {
    const statusToggle = '<div style="display:flex;align-items:center;gap:0.5rem;"><label class="toggle-switch" title="Bật/Tắt agent">' +
      '<input type="checkbox" class="agent-toggle" data-id="' + agent.id + '" ' + (agent.isActive ? 'checked' : '') + '>' +
      '<span class="slider"></span></label><span style="font-size:0.85rem;color:#6b7280;" class="toggle-label">' + (agent.isActive ? 'Bật' : 'Tắt') + '</span></div>';

    const keyBadge = agent.key
      ? '<span class="status-badge" style="background:#e0e7ff;color:#3730a3;">' + escapeHtml(agent.key) + '</span>'
      : '<span style="color:#999;">—</span>';

    const agentsCount = Array.isArray(agent.allowedAgents) ? agent.allowedAgents.length : 0;
    const skillsCount = Array.isArray(agent.allowedSkills) ? agent.allowedSkills.length : 0;
    const toolsCount = Array.isArray(agent.allowedTools) ? agent.allowedTools.length : 0;

    const isSkill = agent.type === "skill";

    let statsBlocks = '';
    if (isSkill) {
      if (toolsCount > 0) {
        statsBlocks += '<div style="display:flex;align-items:center;gap:0.3rem;" title="Tools">' +
          '<svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>' +
          '<span>' + toolsCount + '</span></div>';
      }
    } else {
      statsBlocks += '<div style="display:flex;align-items:center;gap:0.3rem;" title="Sub Agents">' +
        '<svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>' +
        '<span>' + agentsCount + '</span></div>';
      statsBlocks += '<div style="display:flex;align-items:center;gap:0.3rem;" title="Skills">' +
        '<svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>' +
        '<span>' + skillsCount + '</span></div>';
      statsBlocks += '<div style="display:flex;align-items:center;gap:0.3rem;" title="Tools">' +
        '<svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>' +
        '<span>' + toolsCount + '</span></div>';
    }
    const statsHtml = statsBlocks ? '<div style="display:flex;gap:1rem;font-size:0.85rem;color:#6b7280;margin-top:0.3rem;">' + statsBlocks + '</div>' : '';

    const systemBadge = agent.isSystem
      ? '<span style="font-size:0.7rem;background:#ef4444;color:#fff;padding:0.1rem 0.3rem;border-radius:4px;margin-left:0.4rem;vertical-align:middle;">SYSTEM</span>'
      : '';
    const icon = isSkill
      ? '<svg class="admin-icon" style="width:20px;height:20px;margin-right:0.4rem;color:var(--color-primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>'
      : '<svg class="admin-icon" style="width:20px;height:20px;margin-right:0.4rem;color:var(--color-primary);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="7" width="16" height="12" rx="2"></rect><path d="M12 7V3M8 11h.01M16 11h.01M9 15h6"></path></svg>';
    const deleteBtn = agent.isSystem ? '' : '<button class="btn btn-danger btn-icon" data-action="delete" data-id="' + agent.id + '" title="Xoá" aria-label="Xoá">' + window.adminIcon("trash") + '</button>';

    const subLine = isSkill
      ? (agent.systemPrompt ? escapeHtml(agent.systemPrompt) : '<span style="color:#999;">(chưa có mô tả)</span>')
      : escapeHtml(agent.provider) + ' — ' + escapeHtml(agent.model);

    return (
      '<div class="card" style="display:flex;flex-direction:column;gap:1rem;height:100%;">' +
      '<div style="display:flex;justify-content:space-between;align-items:flex-start;">' +
      '<div>' +
      '<h3 style="margin:0 0 0.2rem;font-size:1.1rem;display:flex;align-items:center;">' + icon + '<a href="/admin/agents/' + agent.id + '" style="text-decoration:none;color:var(--text-color);">' + escapeHtml(agent.name) + '</a>' + systemBadge + '</h3>' +
      '<div style="font-size:0.85rem;color:#6b7280;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;" ' + (isSkill && agent.systemPrompt ? 'title="' + escapeHtml(agent.systemPrompt) + '"' : '') + '>' + subLine + '</div>' +
      '</div>' +
      '</div>' +
      statsHtml +
      '<div style="margin-top:5px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid #e5e7eb;padding-top:1rem;">' +
      statusToggle +
      '<div style="display:flex;gap:0.5rem;">' +
      '<a href="/admin/agents/' + agent.id + '" class="btn">Cấu hình</a>' +
      deleteBtn +
      '</div>' +
      '</div>' +
      '</div>'
    );
  }

  async function load(gridId, type, emptyLabel) {
    const res = await fetch("/admin/api/agents?type=" + type);
    if (!res.ok) {
      showError("Không tải được danh sách");
      return;
    }
    const { agents } = await res.json();
    const grid = document.getElementById(gridId);
    grid.innerHTML = agents.length
      ? agents.map(rowHtml).join("")
      : '<div class="empty-state" style="grid-column:1/-1;">' + emptyLabel + '</div>';
  }

  function wireGrid(gridId, type, emptyLabel) {
    const grid = document.getElementById(gridId);

    grid.addEventListener("click", async (event) => {
      const btn = event.target.closest("button[data-action=delete]");
      if (!btn) return;
      if (!confirm("Xoá mục này?")) return;

      const res = await fetch("/admin/api/agents/" + btn.dataset.id, { method: "DELETE" });
      if (!res.ok) {
        showError("Xoá thất bại");
        return;
      }
      load(gridId, type, emptyLabel);
    });

    grid.addEventListener("change", async (event) => {
      const toggle = event.target.closest(".agent-toggle");
      if (!toggle) return;

      const isActive = toggle.checked;
      const labelSpan = toggle.closest('div').querySelector('.toggle-label');
      if (labelSpan) labelSpan.textContent = isActive ? 'Bật' : 'Tắt';

      const res = await fetch("/admin/api/agents/" + toggle.dataset.id, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ isActive })
      });

      if (!res.ok) {
        showError("Cập nhật trạng thái thất bại");
        toggle.checked = !isActive; // revert
        if (labelSpan) labelSpan.textContent = !isActive ? 'Bật' : 'Tắt';
      }
    });
  }

  wireGrid("agents-grid", "agent", "Chưa có agent nào.");
  wireGrid("skills-grid", "skill", "Chưa có skill nào.");
  load("agents-grid", "agent", "Chưa có agent nào.");
  load("skills-grid", "skill", "Chưa có skill nào.");
})();
</script>
{% endblock %}
