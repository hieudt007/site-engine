<!-- Popup dung chung de tao/sua Skill tai cho (khong dieu huong sang trang rieng) - include vao
     bat ky trang nao can (agents-list.liquid, agent-edit.liquid) qua tag render cua Liquid (KHONG
     viet vi du cu the o day - Liquid khong hieu comment HTML, viet lai dung cu phap se tu render
     chinh no, gay de quy vo han - da gap loi nay 1 lan). Sau khi luu thanh cong, dispatch
     CustomEvent "skill-saved" tren document - trang include tu lang nghe su kien nay de tu lam moi
     danh sach cua no (moi trang lam moi theo cach rieng). -->
<dialog id="skill-modal" style="width: 650px; max-width: 95vw; padding: 0; border: none; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
  <form id="skill-modal-form" style="display: flex; flex-direction: column;">
    <input type="hidden" name="id">
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;">
      <h3 style="margin: 0; font-size: 1.1rem;" id="skill-modal-title">Skill mới</h3>
      <button type="button" onclick="document.getElementById('skill-modal').close()" style="background: none; border: none; font-size: 1.5rem; line-height: 1; cursor: pointer; color: #6b7280; padding: 0;">&times;</button>
    </div>

    <div style="padding: 1.5rem; display: flex; flex-direction: column; gap: 0.25rem; max-height: 70vh; overflow-y: auto;">
      <div>
        <label>Tên hiển thị</label>
        <input type="text" name="name" required placeholder="VD: Chống rập khuôn thiết kế">
      </div>
      <div>
        <label>Skill key</label>
        <input type="text" name="key" required placeholder="vd: design_review">
        <div class="field-hint" id="skill-modal-key-hint">Agent gọi skill bằng key này. Không thể sửa sau khi tạo.</div>
      </div>
      <div>
        <label>Mô tả ngắn (để AI agent biết khi nào dùng)</label>
        <textarea name="systemPromptSkill" style="min-height:60px;"></textarea>
      </div>
      <div>
        <label>Nội dung chi tiết (Bí kíp)</label>
        <textarea name="content" style="min-height:220px;" placeholder="Hướng dẫn/code mẫu chi tiết — trả về nguyên văn khi agent gọi skill này."></textarea>
      </div>
      <div>
        <label>Tools</label>
        <div class="field-hint">Công cụ sẽ được bật sau khi agent gọi skill này.</div>
        <input type="search" id="skill-modal-tools-search" placeholder="Tìm công cụ..." style="margin:0.4rem 0 0.5rem;">
        <div id="skill-modal-tools-list" style="display:flex; flex-direction:column; gap:0.25rem; max-height:220px; overflow-y:auto; border:1px solid #e5e7eb; border-radius:8px; padding:0.35rem;">
          {% for tool in skillAssignableTools %}
            <label class="toggle-row" data-search="{{ tool.label | escape | downcase }} {{ tool.name | escape | downcase }} {{ tool.description | escape | downcase }}" style="display:flex; align-items:flex-start; gap:0.5rem; margin:0; padding:0.55rem; border-radius:6px; cursor:pointer;">
              <span class="toggle-switch"><input type="checkbox" class="skill-modal-tool-check" value="{{ tool.name | escape }}"><span class="slider"></span></span>
              <span>
                <span style="font-size:0.88rem; font-weight:600;">{{ tool.label | escape }}</span>
                <div style="font-size:0.75rem;color:#94a3b8;font-family:monospace;">{{ tool.name | escape }}</div>
              </span>
            </label>
          {% endfor %}
        </div>
      </div>
      <label style="display:flex;align-items:center;gap:0.6rem; cursor:pointer;">
        <span class="toggle-switch"><input type="checkbox" name="isActive" checked><span class="slider"></span></span>
        <strong>Kích hoạt</strong>
      </label>
      <div id="skill-modal-error" style="color: var(--color-danger); font-size: 0.85rem;"></div>
    </div>

    <div style="padding: 1.25rem 1.5rem; border-top: 1px solid #e5e7eb; background: #f9fafb; display: flex; justify-content: flex-end; gap: 0.5rem; border-radius: 0 0 12px 12px;">
      <button type="button" class="btn" onclick="document.getElementById('skill-modal').close()">Hủy</button>
      <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
  </form>
</dialog>

<script>
(function () {
  const modal = document.getElementById("skill-modal");
  const form = document.getElementById("skill-modal-form");
  const title = document.getElementById("skill-modal-title");
  const keyInput = form.key;
  const keyHint = document.getElementById("skill-modal-key-hint");
  const errorEl = document.getElementById("skill-modal-error");
  const toolsSearch = document.getElementById("skill-modal-tools-search");
  const toolChecks = () => Array.from(form.querySelectorAll(".skill-modal-tool-check"));

  if (toolsSearch) {
    toolsSearch.addEventListener("input", () => {
      const q = toolsSearch.value.trim().toLowerCase();
      document.querySelectorAll("#skill-modal-tools-list .toggle-row").forEach((row) => {
        const haystack = row.getAttribute("data-search") || "";
        row.style.display = !q || haystack.includes(q) ? "flex" : "none";
      });
    });
  }

  // skill = null -> tao moi. skill = object (tu API /admin/api/agents?type=skill) -> sua.
  window.openSkillModal = function (skill) {
    form.reset();
    errorEl.textContent = "";
    if (toolsSearch) toolsSearch.value = "";
    document.querySelectorAll("#skill-modal-tools-list .toggle-row").forEach((row) => row.style.display = "flex");
    toolChecks().forEach((input) => input.checked = false);
    if (skill) {
      title.textContent = "Sửa Skill";
      form.id.value = skill.id;
      form.name.value = skill.name;
      keyInput.value = skill.key || "";
      keyInput.readOnly = true;
      keyHint.textContent = "Không thể sửa key sau khi tạo.";
      form.systemPromptSkill.value = skill.systemPrompt || "";
      form.content.value = skill.content || "";
      form.isActive.checked = skill.isActive !== false;
      const allowedTools = Array.isArray(skill.allowedTools) ? skill.allowedTools : [];
      toolChecks().forEach((input) => input.checked = allowedTools.includes(input.value));
    } else {
      title.textContent = "Skill mới";
      form.id.value = "";
      keyInput.readOnly = false;
      keyHint.textContent = "Agent gọi skill bằng key này. Không thể sửa sau khi tạo.";
    }
    modal.showModal();
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.textContent = "";

    const id = form.id.value;
    const payload = {
      name: form.name.value.trim(),
      key: form.key.value.trim() || undefined,
      type: "skill",
      provider: "openai",
      model: "skill",
      systemPrompt: form.systemPromptSkill.value || undefined,
      content: form.content.value || undefined,
      allowedTools: toolChecks().filter((input) => input.checked).map((input) => input.value),
      isActive: form.isActive.checked,
    };

    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = "Đang lưu...";

    try {
      const res = await fetch(id ? "/admin/api/agents/" + id : "/admin/api/agents", {
        method: id ? "PATCH" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const body = await res.json();

      if (!res.ok) {
        if (body.error && typeof body.error === "object" && body.error.fieldErrors) {
          errorEl.textContent = Object.values(body.error.fieldErrors).flat().join(", ");
        } else {
          errorEl.textContent = body.error || "Lưu skill thất bại";
        }
      } else {
        modal.close();
        document.dispatchEvent(new CustomEvent("skill-saved", { detail: body.agent }));
      }
    } catch (err) {
      errorEl.textContent = "Lỗi mạng hoặc server";
    } finally {
      btn.disabled = false;
      btn.textContent = "Lưu";
    }
  });
})();
</script>
