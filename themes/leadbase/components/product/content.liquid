{% comment %}
@description: Khoi noi dung dai, thong so, custom fields va danh gia cua san pham. FAQ nam rieng o components/product/faq.liquid, khong o day.
@required_substrings: product.description, product.customFields, {% render "custom-fields", reviews, avgRating
@required_ids: review-form, review-msg
@notes: Nhan product, reviews va avgRating. Sua mo ta dai, thong so, custom fields va danh gia/review o day. PHAI giu {% render "custom-fields", fields: product.customFields %}. JS gui danh gia doc form#review-form va #review-msg. Form can customerName, rating va comment. Mo ta dai duoc gioi han max-height voi nut "Doc them" (JS: #product-description-toggle).
{% endcomment %}
<div class="relative z-10">
    <div class="bg-white/80 backdrop-blur-2xl border border-white/60 rounded-[24px] p-6 lg:p-12 shadow-[0_8px_32px_rgba(0,0,0,0.04)] relative overflow-hidden">
        <!-- Organic background blobs -->
        <div class="absolute top-0 right-0 -mr-32 -mt-32 w-96 h-96 bg-brand/10 rounded-full blur-[80px] pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 -ml-32 -mb-32 w-96 h-96 bg-[#87CEEB]/10 rounded-full blur-[80px] pointer-events-none"></div>

        <!-- Tabs Navigation -->
        <div class="relative border-b border-brand-dark/10 mb-10 z-10">
            <nav class="flex space-x-8 overflow-x-auto no-scrollbar" aria-label="Tabs">
                <button type="button" class="tab-btn text-brand border-brand border-b-2 py-4 px-1 text-base font-medium font-sans whitespace-nowrap transition-colors" data-target="tab-description">
                    Chi tiết sản phẩm
                </button>
                <button type="button" class="tab-btn text-brand-dark/50 border-transparent border-b-2 py-4 px-1 text-base font-medium font-sans whitespace-nowrap hover:text-brand transition-colors" data-target="tab-reviews">
                    Đánh giá ({{ reviews.size }})
                </button>
            </nav>
        </div>

        <!-- Tab Content: Description & Custom Fields -->
        <div id="tab-description" class="tab-content relative z-10 animate-fade-up">
            <div class="grid grid-cols-1 {% if product.customFields %}lg:grid-cols-3{% endif %} gap-12">
                <div class="{% if product.customFields %}lg:col-span-2{% endif %}">
                    <div class="product-description-wrap relative">
                        <div id="product-description-content" class="product-description-content text-brand-dark/80 font-sans leading-relaxed text-base max-h-[420px] overflow-hidden
                                    [&>p]:mb-6 [&>p:last-child]:mb-0
                                    [&>h1]:text-3xl [&>h1]:font-sans [&>h1]:text-brand-dark [&>h1]:mb-6 [&>h1]:mt-10
                                    [&>h2]:text-2xl [&>h2]:font-sans [&>h2]:text-brand-dark [&>h2]:mb-4 [&>h2]:mt-8
                                    [&>h3]:text-xl [&>h3]:font-sans [&>h3]:text-brand-dark [&>h3]:mb-3 [&>h3]:mt-6
                                    [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:mb-6 [&>ul>li]:mb-2 [&>ul>li]:marker:text-brand
                                    [&>ol]:list-decimal [&>ol]:pl-5 [&>ol]:mb-6 [&>ol>li]:mb-2
                                    [&>strong]:font-medium [&>strong]:text-brand-dark
                                    [&>a]:text-brand [&>a]:underline [&>a]:underline-offset-4 hover:[&>a]:text-brand-dark transition-colors">
                            {{ product.description }}
                        </div>
                        <div id="product-description-fade" class="absolute bottom-10 left-0 w-full h-24 bg-gradient-to-t from-white to-transparent pointer-events-none"></div>
                        <button type="button" id="product-description-toggle" class="mt-2 inline-flex items-center gap-1.5 text-brand font-medium text-sm hover:text-brand-dark transition-colors">
                            <span>Đọc thêm</span>
                            <svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </button>
                    </div>
                </div>
                {% if product.customFields %}
                <div class="lg:col-span-1 sticky top-20">
                    <div class="flex items-center gap-3 mb-6 border-b border-brand-dark/10 pb-4">
                        <svg class="w-6 h-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <h3 class="text-xl font-sans text-brand-dark">Thông số kỹ thuật</h3>
                    </div>
                    <div class="custom-fields-wrapper font-sans text-sm">
                        {% render "custom-fields", fields: product.customFields %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Tab Content: Reviews -->
        <div id="tab-reviews" class="tab-content hidden relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                
                <!-- Reviews List -->
                <div class="lg:col-span-7 order-2 lg:order-1">
                    <div class="flex items-center gap-6 mb-10 p-6 bg-brand/5 rounded-[24px] border border-brand/10">
                        <div class="text-6xl font-sans text-brand-dark leading-none">{{ avgRating }}</div>
                        <div class="flex flex-col gap-1">
                            <div class="flex text-brand text-xl">
                                ★ ★ ★ ★ ★
                            </div>
                            <span class="text-sm text-brand-dark/60 font-sans">Dựa trên {{ reviews.size }} đánh giá từ khách hàng</span>
                        </div>
                    </div>

                    <div class="space-y-6">
                        {% if reviews.size > 0 %}
                            {% for review in reviews %}
                                <div class="p-6 bg-white rounded-[24px] shadow-[0_4px_20px_rgba(0,0,0,0.02)] border border-brand/5 transition-all hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)]">
                                    <div class="flex justify-between items-start mb-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full bg-brand/10 text-brand flex items-center justify-center font-sans font-medium text-lg">
                                                {{ review.customerName | slice: 0, 1 | upcase }}
                                            </div>
                                            <div>
                                                <div class="font-medium text-brand-dark font-sans">{{ review.customerName }}</div>
                                                <div class="text-xs text-brand-dark/40 font-sans mt-0.5">Khách hàng xác thực</div>
                                            </div>
                                        </div>
                                        <div class="flex text-brand text-sm">
                                            {% assign rating_num = review.rating | plus: 0 %}
                                            {% for i in (1..5) %}
                                                {% if i <= rating_num %}★{% else %}<span class="text-gray-200">★</span>{% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <p class="text-brand-dark/70 text-sm font-sans leading-relaxed">{{ review.comment }}</p>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-16 bg-brand/5 rounded-[24px] border border-brand/10 border-dashed">
                                <svg class="w-12 h-12 text-brand/30 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                </svg>
                                <p class="text-brand-dark/50 font-sans">Chưa có đánh giá nào. Hãy là người đầu tiên chia sẻ cảm nhận của bạn!</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Review Form -->
                <div class="lg:col-span-5 order-1 lg:order-2">
                    <div class="bg-brand-dark text-white rounded-[24px] p-8 lg:p-10 sticky top-32 shadow-2xl relative overflow-hidden">
                        <!-- Decorative blob in form -->
                        <div class="absolute top-0 right-0 -mr-16 -mt-16 w-48 h-48 bg-brand/20 rounded-full blur-[40px] pointer-events-none"></div>

                        <div class="relative z-10">
                            <h3 class="text-2xl font-sans mb-2">Viết đánh giá</h3>
                            <p class="text-white/60 font-sans text-sm mb-8">Chia sẻ trải nghiệm của bạn về sản phẩm thiên nhiên này.</p>
                            
                            <form id="review-form" class="space-y-5">
                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-white/70 mb-2 font-sans">Họ và tên</label>
                                    <input type="text" name="customerName" required class="w-full bg-white/10 border border-white/20 rounded-[16px] px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-colors font-sans">
                                </div>
                                
                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-white/70 mb-2 font-sans">Đánh giá của bạn</label>
                                    <div class="flex items-center gap-2 star-rating-ui cursor-pointer py-2">
                                        <span data-value="1" class="text-2xl text-white/20 hover:text-brand transition-colors">★</span>
                                        <span data-value="2" class="text-2xl text-white/20 hover:text-brand transition-colors">★</span>
                                        <span data-value="3" class="text-2xl text-white/20 hover:text-brand transition-colors">★</span>
                                        <span data-value="4" class="text-2xl text-white/20 hover:text-brand transition-colors">★</span>
                                        <span data-value="5" class="text-2xl text-white/20 hover:text-brand transition-colors">★</span>
                                    </div>
                                    <input type="number" name="rating" id="real-rating-input" min="1" max="5" required class="sr-only">
                                </div>

                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-white/70 mb-2 font-sans">Nội dung</label>
                                    <textarea name="comment" required rows="4" class="w-full bg-white/10 border border-white/20 rounded-[16px] px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-colors font-sans resize-none"></textarea>
                                </div>

                                <button type="submit" class="w-full bg-brand text-white px-8 py-4 rounded-[16px] text-sm font-medium tracking-widest uppercase hover:bg-white hover:text-brand-dark transition-all duration-300 font-sans flex items-center justify-center gap-2 group mt-4">
                                    <span>Gửi đánh giá</span>
                                    <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                </button>
                            </form>
                            
                            <div id="review-msg" class="mt-6 text-sm font-sans hidden rounded-[16px] p-4"></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>