{% comment %}
@description: Khoi FAQ rieng cua san pham, dung chung style header voi components/product/related.liquid.
@required_substrings: product.faq
@required_ids:
@notes: Nhan product. Tu an khi product.faq rong/null. JS toggle accordion nam trong assets/sources/components/product/content.js (khong co faq.js rieng vi file nay khong nam trong THEME_FILE_CONTRACTS co dinh nen se khong duoc bundler gom vao custom.js).
{% endcomment %}
{% if product.faq and product.faq.size > 0 %}
<section class="product-faq-section py-12 md:py-20 relative z-10 overflow-hidden">
    <div class="max-w-[1200px] mx-auto px-4 relative z-10">
        <div class="faq-section-header text-center mb-12 md:mb-16 flex flex-col items-center">
            <span class="text-blue-600 font-medium tracking-widest uppercase text-xs mb-3 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Hỏi & Đáp
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </span>
            <h2 class="text-2xl md:text-3xl font-sans text-slate-950 mb-6">Câu hỏi thường gặp</h2>
            <div class="w-16 h-1 bg-gradient-to-r from-blue-200 via-blue-400 to-blue-200 rounded-full"></div>
        </div>

        <div class="max-w-3xl mx-auto space-y-3">
            {% for item in product.faq %}
            <div class="faq-item border border-blue-100/50 rounded-[16px] overflow-hidden bg-white">
                <button type="button" class="faq-question w-full flex items-center justify-between gap-4 text-left px-5 py-4 font-medium text-slate-950 hover:bg-blue-50/50 transition-colors">
                    <span>{{ item.question }}</span>
                    <svg class="w-5 h-5 text-blue-600 shrink-0 transition-transform faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
                <div class="faq-answer hidden px-5 pb-4 text-slate-600 text-sm leading-relaxed">
                    {{ item.answer }}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
