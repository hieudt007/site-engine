{% comment %}
Widget live-chat AI CSKH (agent key="customer") - ban rieng cua theme leadbase, override ban
dung chung o themes/default/components/customer-chat.liquid. JS chung (assets/customer-chat/
chat-drawer.js) doc theo CLASS (khong phai id) cho phan lon phan tu - PHAI giu nguyen toan bo
class .plugin-chat-* va cac id #plugin-chat-attach/file/preview*, khong duoc doi ten.
BAT BUOC: noi goi {% render "components/customer-chat" %} (layout.liquid) PHAI truyen tay du
site: site, chatSessionId: chatSessionId, chatHmacToken: chatHmacToken - {% render %} cua LiquidJS
co lap scope hoan toan, KHONG tu ke thua bien global, thieu se lam avatar/ten site trong header
rong VA data-session-id/data-hmac rong (chat-drawer.js dung 2 attribute nay lam fallback session
khi localStorage chua co, thieu se anh huong that den xac thuc phien chat lan dau).
{% endcomment %}
<link rel="stylesheet" href="/assets/customer-chat/chat-drawer.css">
<script src="/assets/customer-chat/chat-drawer.js" defer></script>
{% comment %} Script api.js da nap 1 lan duy nhat o layout.liquid (dung chung voi widget checkout
neu co) - o day chi con lai div ".cf-turnstile". "invisible" KHONG PHAI gia tri hop le cho
data-size (chi nhan "normal"/"compact"/"flexible", loi that da gap: "Invalid value for parameter
size" tren console) - muon widget an di khi khong can xac thuc them thi dung data-appearance=
"interaction-only" (chi hien khi Cloudflare thay nghi ngo can nguoi dung tuong tac). {% endcomment %}
<div id="plugin-chat-drawer" class="plugin-chat-container fixed bottom-5 right-5 z-50" data-session-id="{{ chatSessionId | escape }}" data-hmac="{{ chatHmacToken | escape }}">

  <!-- Tooltip goi y -->
  <div class="plugin-chat-tooltip hidden absolute bottom-[76px] right-0 w-max max-w-[220px] rounded-2xl rounded-br-md bg-white px-4 py-3 text-sm text-slate-700 shadow-lg border border-slate-100">
    Cần hỗ trợ? Nhắn cho chúng tôi 👋
    <button class="plugin-chat-tooltip-close absolute -top-2 -right-2 h-5 w-5 rounded-full bg-slate-200 text-slate-500 text-xs hover:bg-slate-300">&times;</button>
  </div>

  <button class="plugin-chat-toggle flex h-14 w-14 items-center justify-center rounded-full bg-brand text-white shadow-lg shadow-blue-900/20 transition-transform hover:scale-105 hover:bg-brand-hover">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>

  <div class="plugin-chat-drawer hidden absolute bottom-[68px] right-0 flex w-80 flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-2xl md:w-96" style="height: 520px; max-height: calc(100vh - 120px);">
    <div class="flex items-center justify-between bg-brand-dark px-5 py-4 text-white">
      <div class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-sm font-semibold">{{ site.siteName | slice: 0, 1 }}</span>
        <div>
          <p class="text-sm font-semibold leading-tight">{{ site.siteName }}</p>
          <p class="text-xs text-white/50 leading-tight">Thường trả lời ngay</p>
        </div>
      </div>
      <button class="plugin-chat-close text-white/60 hover:text-white transition-colors">&times;</button>
    </div>

    <div class="plugin-chat-messages flex flex-1 flex-col gap-3 overflow-y-auto bg-slate-50 p-4">
      <div class="plugin-chat-message assistant max-w-[85%] self-start rounded-2xl rounded-bl-md border border-slate-100 bg-white p-3 text-sm text-slate-700 shadow-sm">
        Xin chào! Tôi có thể giúp gì cho bạn?
      </div>
    </div>

    <div id="plugin-chat-preview" class="hidden flex items-center justify-between border-t border-slate-100 bg-slate-50 p-2">
      <div class="flex items-center gap-2">
        <img id="plugin-chat-preview-img" class="h-10 w-10 rounded-lg border border-slate-200 object-cover" src="" alt="preview">
        <span id="plugin-chat-preview-name" class="max-w-[150px] truncate text-xs text-slate-500"></span>
      </div>
      <button id="plugin-chat-preview-close" class="px-2 font-medium text-slate-400 hover:text-red-500">&times;</button>
    </div>

    {% if site.turnstileSiteKey %}
    <div class="flex justify-center border-t border-slate-100 bg-white px-3 pt-2">
      <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey | escape }}" data-appearance="interaction-only"></div>
    </div>
    {% endif %}

    <form class="plugin-chat-form flex items-center gap-2 border-t border-slate-100 bg-white p-3">
      <input type="file" id="plugin-chat-file" accept="image/jpeg, image/png, image/webp, image/gif" class="hidden">
      <button type="button" id="plugin-chat-attach" class="rounded-lg p-1.5 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600" title="Đính kèm ảnh">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
      </button>
      <input type="text" class="plugin-chat-input flex-1 rounded-full border border-slate-200 px-4 py-2 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand" placeholder="Nhập tin nhắn..." autocomplete="off">
      <button type="submit" class="flex items-center justify-center rounded-full bg-brand p-2.5 text-white transition-colors hover:bg-brand-hover" aria-label="Gửi">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </button>
    </form>
  </div>
</div>
