{% comment %}
@description: Trang thanh toán don hang (checkout).
@required_substrings: {% layout "layout" %}, {% block content %}, {% endblock %}
@required_ids: checkout-items, checkout-form, checkout-total, checkout-error
@notes: JS (giu nguyen) doc localStorage, bom danh sach sp tom tat vao #checkout-items, form#checkout-form co input[name=customerName]/customerPhone/customerAddress, hien tong vao #checkout-total, loi vao #checkout-error. DUOC PHEP them input dat ten tuy y vao form nay (vd <input name="secondaryPhone">) - JS tu dong gop moi input NGOAI cac field chuan thanh customFields. Khi URL co ?buyNowProductId=...&buyNowVariantId=... (luong "Mua ngay" tu trang san pham), JS CHI hien thi/dat hang dung 1 san pham nay, khong dong voi gio hang that trong localStorage - xem checkout.js va product-detail.js initBuyNow.
{% endcomment %}
{% layout "layout" %}
{% block content %}
{% comment %} Script api.js da nap 1 lan duy nhat o layout.liquid (dung chung voi widget chat) - o
day chi con lai div ".cf-turnstile" de script do tu quet/render. {% endcomment %}
<div class="min-h-screen bg-[#eff6ff] relative overflow-hidden pt-8 md:pt-10 pb-20">
    <!-- Background Organic Blobs -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-[60%] h-[60%] bg-blue-200/30 rounded-full blur-[120px] mix-blend-multiply animate-pulse" style="animation-duration: 8s;"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-teal-200/30 rounded-full blur-[100px] mix-blend-multiply animate-pulse" style="animation-duration: 10s;"></div>
    </div>

    <div class="max-w-[1200px] mx-auto px-4 relative z-10">
        <div class="text-center mb-12">
            <h1 class="font-sans text-4xl md:text-5xl text-slate-900 mb-4">Thanh toán</h1>
            <p class="text-blue-700/70 font-sans">Kiểm tra lại thông tin đơn hàng trước khi hoàn tất</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Left Column: Form -->
            <div class="lg:col-span-7 transform transition-all duration-700 translate-y-0 opacity-100">
                <form id="checkout-form" class="space-y-6">
                    <!-- Contact Info -->
                    <div class="bg-white p-6 md:p-8 rounded-[24px] border border-blue-50 shadow-[0_8px_32px_rgba(5,150,105,0.06)] relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-bl-full -z-10 opacity-50"></div>
                        <h2 class="font-heading text-xl text-slate-900 mb-6 flex items-center gap-3">
                            <span class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-sm font-medium">1</span>
                            Thông tin liên hệ
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-sm font-medium text-slate-900 mb-2">Họ và tên *</label>
                                <input type="text" name="customerName" required class="w-full px-5 py-3.5 bg-blue-50/50 border border-blue-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all text-slate-900 placeholder-slate-900/40 rounded-[24px]" placeholder="Nhập họ và tên">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-900 mb-2">Số điện thoại *</label>
                                <input type="tel" name="customerPhone" required class="w-full px-5 py-3.5 bg-blue-50/50 border border-blue-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all text-slate-900 placeholder-slate-900/40 rounded-[24px]" placeholder="Nhập số điện thoại">
                            </div>
                        </div>
                    </div>

                    <!-- Fulfillment -->
                    <div class="bg-white p-6 md:p-8 rounded-[24px] border border-blue-50 shadow-[0_8px_32px_rgba(5,150,105,0.06)] relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-bl-full -z-10 opacity-50"></div>
                        <h2 class="font-heading text-xl text-slate-900 mb-6 flex items-center gap-3">
                            <span class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-sm font-medium">2</span>
                            Phương thức nhận hàng
                        </h2>
                        <div id="fulfillment-methods-list" class="mb-6 space-y-3">
                            <!-- JS renders here -->
                            <div class="animate-pulse flex space-x-4">
                                <div class="h-14 bg-blue-50 rounded-[24px] w-full"></div>
                            </div>
                        </div>

                        <div id="delivery-fields" class="space-y-5 hidden animate-fade-in">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-slate-900 mb-2">Tỉnh/Thành phố *</label>
                                    <div class="relative">
                                        <select name="customerProvince" class="w-full px-5 py-3.5 bg-blue-50/50 border border-blue-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all text-slate-900 appearance-none rounded-[24px] cursor-pointer">
                                            <option value="">Chọn Tỉnh/Thành phố</option>
                                        </select>
                                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-5 text-blue-600">
                                            <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
                                        </div>
                                    </div>
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-slate-900 mb-2">Địa chỉ chi tiết *</label>
                                    <input type="text" name="customerAddress" class="w-full px-5 py-3.5 bg-blue-50/50 border border-blue-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all text-slate-900 placeholder-slate-900/40 rounded-[24px]" placeholder="Số nhà, tên đường, phường/xã, quận/huyện">
                                </div>
                            </div>
                        </div>

                        <div id="pickup-fields" class="space-y-5 hidden animate-fade-in">
                            <div>
                                <label class="block text-sm font-medium text-slate-900 mb-2">Chọn cửa hàng *</label>
                                <div class="relative">
                                    <select name="storeId" class="w-full px-5 py-3.5 bg-blue-50/50 border border-blue-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all text-slate-900 appearance-none rounded-[24px] cursor-pointer">
                                        <option value="">Chọn cửa hàng</option>
                                    </select>
                                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-5 text-blue-600">
                                        <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment -->
                    <div class="bg-white p-6 md:p-8 rounded-[24px] border border-blue-50 shadow-[0_8px_32px_rgba(5,150,105,0.06)] relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-bl-full -z-10 opacity-50"></div>
                        <h2 class="font-heading text-xl text-slate-900 mb-6 flex items-center gap-3">
                            <span class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-sm font-medium">3</span>
                            Phương thức thanh toán
                        </h2>
                        <div id="payment-methods-list" class="space-y-3">
                            <!-- JS renders here -->
                            <div class="animate-pulse flex space-x-4">
                                <div class="h-14 bg-blue-50 rounded-[24px] w-full"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Extra Fields -->
                    <div class="bg-white p-6 md:p-8 rounded-[24px] border border-blue-50 shadow-[0_8px_32px_rgba(5,150,105,0.06)]">
                        <h2 class="font-heading text-xl text-slate-900 mb-6">Ghi chú đơn hàng (Tuỳ chọn)</h2>
                        <textarea name="orderNote" rows="3" class="w-full px-5 py-4 bg-blue-50/50 border border-blue-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all text-slate-900 placeholder-slate-900/40 rounded-[24px] resize-none" placeholder="Ghi chú thêm về thời gian giao hàng, yêu cầu đóng gói..."></textarea>
                    </div>

                    <div class="space-y-3">
                        {% if site.turnstileSiteKey %}
                        <div class="flex justify-center">
                            <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey | escape }}" data-appearance="interaction-only" data-callback="onCheckoutTurnstileSuccess" data-expired-callback="onCheckoutTurnstileExpired" data-error-callback="onCheckoutTurnstileExpired" data-action="checkout"></div>
                        </div>
                        {% endif %}

                        <div id="checkout-error" class="text-red-500 text-sm font-medium text-center min-h-[20px]"></div>

                        <button type="submit" id="checkout-submit-btn" class="w-full bg-blue-600 text-white font-medium py-4 px-8 rounded-[24px] hover:bg-blue-700 hover:shadow-[0_8px_24px_rgba(5,150,105,0.25)] transition-all duration-400 flex justify-center items-center group relative overflow-hidden">
                        <span class="relative z-10 flex items-center text-lg">
                            Hoàn tất đặt hàng
                            <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </span>
                        <div class="absolute inset-0 h-full w-0 bg-blue-700 transition-all duration-500 ease-out group-hover:w-full z-0"></div>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Right Column: Summary -->
            <div class="lg:col-span-5 relative">
                <div class="bg-white p-6 md:p-8 rounded-[24px] border border-blue-50 shadow-[0_12px_40px_rgba(5,150,105,0.08)] lg:sticky lg:top-32">
                    <h2 class="font-heading text-xl text-slate-900 mb-6 border-b border-blue-100 pb-4">Tóm tắt đơn hàng</h2>
                    
                    <div id="checkout-items" class="space-y-1 mb-6 max-h-[40vh] overflow-y-auto pr-2 checkout-scrollbar">
                        <!-- JS renders items here -->
                        <div class="animate-pulse space-y-4">
                            <div class="h-12 bg-blue-50 rounded-[16px] w-full"></div>
                            <div class="h-12 bg-blue-50 rounded-[16px] w-full"></div>
                        </div>
                    </div>

                    <div class="border-t border-blue-100 pt-6 mb-6">
                        <div class="flex gap-2">
                            <input type="text" id="coupon-code-input" name="couponCode" form="checkout-form" placeholder="Mã giảm giá" class="flex-1 px-5 py-3.5 bg-blue-50/50 border border-blue-100 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all text-slate-900 text-sm rounded-[24px] placeholder-slate-900/40">
                            <button type="button" id="apply-coupon-btn" class="whitespace-nowrap flex-shrink-0 bg-blue-50 text-blue-700 px-6 py-3.5 font-medium hover:bg-blue-600 hover:text-white rounded-[24px] transition-colors text-sm border border-blue-100 hover:border-blue-600">Áp dụng</button>
                        </div>
                        <p id="coupon-message" class="mt-2 text-sm hidden"></p>
                    </div>

                    <div class="border-t border-blue-100 pt-6">
                        <div class="flex justify-between items-center mb-3 text-slate-900/70 text-sm">
                            <span>Tạm tính</span>
                            <span id="subtotal-display" class="font-medium text-slate-900">--</span>
                        </div>
                        <div id="discount-row" class="hidden justify-between items-center mb-3 text-sm">
                            <span class="text-blue-600">Giảm giá</span>
                            <span id="discount-display" class="font-medium text-blue-600">--</span>
                        </div>
                        <div class="flex justify-between items-center mb-4 text-slate-900/70 text-sm">
                            <span>Phí vận chuyển</span>
                            <span class="font-medium text-slate-900">Tính khi thanh toán</span>
                        </div>
                        <div class="flex justify-between items-end border-t border-blue-100 pt-5 mt-2">
                            <span class="font-heading text-xl text-slate-900">Tổng cộng</span>
                            <span id="checkout-total" class="font-heading text-3xl text-blue-600 font-medium">0₫</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}