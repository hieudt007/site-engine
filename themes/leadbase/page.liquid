{% comment %}
@description: Trang tinh (Gioi thieu, Lien he...).
@required_substrings: {% layout "layout" %}, {% block content %}, {% endblock %}, page.title, page.body
@required_ids:
@notes: page.body la HTML da sanitize, render RAW. page la nguyen row Post tu CacheService.getPageBySlug (khong select-loc field) nen page.customFields luon co san du template co dung hay khong - PHAI giu {% render "custom-fields", fields: page.customFields %} (truoc day file nay thieu hoan toan, admin tu dat "Trường tuỳ biến" nhung khach khong bao gio thay duoc - da sua).
{% endcomment %}
{% layout "layout" %}
{% block content %}
<div class="min-h-screen bg-[#eff6ff] pt-8 md:pt-10 pb-20">
    <main class="mx-auto max-w-[800px] px-6">
        <header class="mb-12 text-center">
            <h1 class="text-[32px] font-semibold text-slate-900 md:text-[40px]">{{ page.title }}</h1>
        </header>
        <article class="prose prose-slate max-w-none prose-headings:font-semibold prose-a:text-brand">
            {{ page.body }}
        </article>
        {% render "custom-fields", fields: page.customFields %}
    </main>
</div>
{% endblock %}
