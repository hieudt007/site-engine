{% comment %}
@description: Trang khong tim thay (404) - dung cho moi URL/slug/id khong ton tai tren toan site.
@required_substrings: {% layout "layout" %}, {% block content %}, {% endblock %}
@required_ids: 
@notes: Nhan bien message (co the rong/khong duoc truyen — PHAI co gia tri mac dinh du hop ly, vd "Không tìm thấy trang bạn cần"). Nen co link ve trang chu.
{% endcomment %}
{% layout "layout" %}
{% block content %}
<div class="page-404-wrapper min-h-[80vh] flex items-center justify-center relative overflow-hidden py-20 px-4 bg-emerald-50/50 font-sans">
    <!-- Background Liquid Blobs -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute top-1/4 left-1/4 w-72 h-72 md:w-96 md:h-96 bg-emerald-200/40 rounded-full mix-blend-multiply filter blur-[60px] opacity-70 animate-blob"></div>
        <div class="absolute top-1/3 right-1/4 w-72 h-72 md:w-96 md:h-96 bg-emerald-500/20 rounded-full mix-blend-multiply filter blur-[60px] opacity-70 animate-blob animation-delay-2000"></div>
        <div class="absolute -bottom-32 left-1/3 w-72 h-72 md:w-96 md:h-96 bg-emerald-600/10 rounded-full mix-blend-multiply filter blur-[60px] opacity-70 animate-blob animation-delay-4000"></div>
    </div>

    <!-- Content Card -->
    <div class="glass-panel relative z-10 max-w-2xl w-full text-center p-10 md:p-16 rounded-[24px] border border-white/60 shadow-[0_8px_32px_rgba(5,150,105,0.08)] backdrop-blur-xl bg-white/80 fade-up-element">
        <!-- Organic decorative element -->
        <div class="flex justify-center mb-6">
            <svg class="w-12 h-12 text-emerald-600/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
            </svg>
        </div>
        
        <h1 class="text-8xl md:text-[150px] leading-none font-serif text-emerald-900 mb-4 drop-shadow-sm font-light tracking-tighter">404</h1>
        <h2 class="text-2xl md:text-3xl font-medium text-emerald-900 mb-6 font-serif">Oops! Không tìm thấy trang</h2>
        <p class="text-emerald-900/70 mb-10 text-lg max-w-md mx-auto leading-relaxed">{{ message | default: "Rất tiếc, trang bạn đang tìm kiếm không tồn tại, đã bị xóa hoặc tạm thời không thể truy cập." }}</p>
        
        <a href="/" class="inline-flex items-center justify-center px-8 py-4 text-sm font-medium tracking-widest text-white transition-all duration-500 bg-emerald-600 rounded-[24px] hover:bg-emerald-700 hover:shadow-[0_10px_25px_rgba(5,150,105,0.3)] hover:-translate-y-1 group uppercase overflow-hidden relative">
            <span class="absolute inset-0 w-full h-full bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></span>
            <svg class="w-5 h-5 mr-3 transition-transform duration-500 group-hover:-translate-x-1 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            <span class="relative z-10">Trở về trang chủ</span>
        </a>
    </div>
</div>
{% endblock %}