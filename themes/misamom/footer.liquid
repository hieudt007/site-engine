{% comment %}
@description: Chan trang.
@required_substrings: site.siteName, footerMenu
@required_ids: 
@notes: Nhan bien site va footerMenu (giong header.liquid), hien nam ban quyen + ten site. NÊN CÓ thêm: Cột nhập email đăng ký nhận bản tin (Newsletter subscription) và các icon mạng xã hội.
{% endcomment %}
<footer class="relative bg-emerald-900 text-emerald-50 pt-20 pb-10 overflow-hidden font-sans">
    <!-- Organic Top Wave -->
    <div class="absolute top-0 left-0 w-full overflow-hidden leading-none z-0 opacity-20 pointer-events-none">
        <svg class="relative block w-full h-[40px] md:h-[60px]" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="#064E3B"></path>
        </svg>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl relative z-10">
        <!-- Top Section: Newsletter -->
        <div class="flex flex-col md:flex-row justify-between items-center pb-12 border-b border-emerald-800 mb-12 gap-8">
            <div class="md:w-1/2 w-full text-center md:text-left">
                <h3 class="text-3xl md:text-4xl font-serif text-white mb-4 tracking-wide">Đăng ký nhận bản tin</h3>
                <p class="text-sm text-emerald-100/80 max-w-md mx-auto md:mx-0 leading-relaxed">Đăng ký để nhận thông tin sớm nhất về các bộ sưu tập mỹ phẩm hữu cơ mới, ưu đãi độc quyền và bí quyết làm đẹp từ thiên nhiên.</p>
            </div>
            <div class="md:w-1/2 w-full">
                <form class="flex relative newsletter-form max-w-md mx-auto md:ml-auto md:mr-0 group">
                    <input type="email" placeholder="Nhập địa chỉ email của bạn..." class="w-full bg-emerald-950/40 border border-emerald-700/50 rounded-full py-3.5 pl-6 pr-32 focus:outline-none focus:border-emerald-400 focus:bg-emerald-950/60 transition-all text-white placeholder-emerald-300/60 text-sm shadow-inner" required>
                    <button type="submit" class="absolute right-1.5 top-1.5 bottom-1.5 px-5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-sm transition-colors shadow-sm flex items-center justify-center gap-2 min-w-[90px]" aria-label="Đăng ký">
                        <span>Gửi</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </button>
                    <div class="newsletter-msg absolute top-full left-0 mt-3 text-sm text-emerald-300 opacity-0 -translate-y-2 transition-all duration-300 pl-4 font-medium"></div>
                </form>
            </div>
        </div>

        <!-- Middle Section: Links & Info -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-16">
            <!-- Brand & Social -->
            <div class="md:col-span-4 flex flex-col items-center md:items-start text-center md:text-left">
                <h4 class="text-2xl font-serif text-white mb-6 tracking-wider uppercase">{{ site.siteName }}</h4>
                <p class="text-sm mb-8 text-emerald-100/70 leading-relaxed pr-0 md:pr-6">
                    Đánh thức vẻ đẹp nguyên bản với các dòng mỹ phẩm hữu cơ cao cấp. Chúng tôi tin vào sức mạnh chữa lành và nuôi dưỡng từ thiên nhiên.
                </p>
                <div class="flex space-x-4">
                    <a href="#" class="social-icon w-10 h-10 rounded-full bg-emerald-800/50 flex items-center justify-center text-emerald-200 hover:bg-emerald-700 hover:text-white shadow-sm" aria-label="Facebook">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
                        </svg>
                    </a>
                    <a href="#" class="social-icon w-10 h-10 rounded-full bg-emerald-800/50 flex items-center justify-center text-emerald-200 hover:bg-emerald-700 hover:text-white shadow-sm" aria-label="Instagram">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
                        </svg>
                    </a>
                    <a href="#" class="social-icon w-10 h-10 rounded-full bg-emerald-800/50 flex items-center justify-center text-emerald-200 hover:bg-emerald-700 hover:text-white shadow-sm" aria-label="YouTube">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Footer Menu -->
            <div class="md:col-span-3 text-center md:text-left">
                <h4 class="text-xs font-semibold tracking-[0.1em] uppercase text-emerald-300 mb-6">Khám Phá</h4>
                <ul class="space-y-3">
                    {% if footerMenu and footerMenu.items.size > 0 %}
                        {% for item in footerMenu.items %}
                            <li>
                                <a href="{{ item.url }}" class="footer-link text-emerald-100/70 hover:text-white transition-colors text-sm inline-block relative py-1">{{ item.label }}</a>
                            </li>
                        {% endfor %}
                    {% else %}
                        <li><a href="#" class="footer-link text-emerald-100/70 hover:text-white transition-colors text-sm inline-block relative py-1">Sản phẩm mới</a></li>
                        <li><a href="#" class="footer-link text-emerald-100/70 hover:text-white transition-colors text-sm inline-block relative py-1">Bán chạy nhất</a></li>
                        <li><a href="#" class="footer-link text-emerald-100/70 hover:text-white transition-colors text-sm inline-block relative py-1">Bộ sưu tập</a></li>
                        <li><a href="#" class="footer-link text-emerald-100/70 hover:text-white transition-colors text-sm inline-block relative py-1">Về thương hiệu</a></li>
                    {% endif %}
                </ul>
            </div>

            <!-- Customer Service -->
            <div class="md:col-span-2 text-center md:text-left">
                <h4 class="text-xs font-semibold tracking-[0.1em] uppercase text-emerald-300 mb-6">Hỗ Trợ</h4>
                <ul class="space-y-3">
                    <li><a href="#" class="footer-link text-emerald-100/70 hover:text-white transition-colors text-sm inline-block relative py-1">Tài khoản</a></li>
                    <li><a href="#" class="footer-link text-emerald-100/70 hover:text-white transition-colors text-sm inline-block relative py-1">Chính sách vận chuyển</a></li>
                    <li><a href="#" class="footer-link text-emerald-100/70 hover:text-white transition-colors text-sm inline-block relative py-1">Đổi trả & Hoàn tiền</a></li>
                    <li><a href="#" class="footer-link text-emerald-100/70 hover:text-white transition-colors text-sm inline-block relative py-1">Câu hỏi thường gặp</a></li>
                </ul>
            </div>

            <!-- Contact -->
            <div class="md:col-span-3 text-center md:text-left">
                <h4 class="text-xs font-semibold tracking-[0.1em] uppercase text-emerald-300 mb-6">Liên Hệ</h4>
                <ul class="space-y-4 text-sm text-emerald-100/70">
                    <li class="flex items-start justify-center md:justify-start gap-3">
                        <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        <span class="leading-relaxed">Tòa nhà Nature, Quận 1<br>TP. Hồ Chí Minh, Việt Nam</span>
                    </li>
                    <li class="flex items-center justify-center md:justify-start gap-3">
                        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        <span>hello@{{ site.siteName | downcase | replace: ' ', '' }}.com</span>
                    </li>
                    <li class="flex items-center justify-center md:justify-start gap-3">
                        <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        <span>1900 123 456</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Bottom Section: Copyright & Payments -->
        <div class="pt-8 border-t border-emerald-800 flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="text-xs text-emerald-200/60 tracking-wide">
                &copy; {{ 'now' | date: '%Y' }} {{ site.siteName }}. All rights reserved.
            </p>
            <div class="flex space-x-4 opacity-60">
                <!-- Payment Icons -->
                <svg class="h-6 w-auto text-emerald-100" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="38" height="24" rx="4" fill="currentColor" fill-opacity="0.1"/>
                    <path d="M12.923 16.5H10.154L11.846 7.5H14.615L12.923 16.5ZM25.846 16.5H23.077L24.769 7.5H27.538L25.846 16.5ZM21.231 16.5H18.462L20.154 7.5H22.923L21.231 16.5Z" fill="currentColor"/>
                </svg>
                <svg class="h-6 w-auto text-emerald-100" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="38" height="24" rx="4" fill="currentColor" fill-opacity="0.1"/>
                    <circle cx="15" cy="12" r="5" fill="currentColor" fill-opacity="0.8"/>
                    <circle cx="23" cy="12" r="5" fill="currentColor" fill-opacity="0.6"/>
                </svg>
            </div>
        </div>
    </div>
</footer>