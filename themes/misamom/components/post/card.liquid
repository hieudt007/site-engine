<article class="post-card group relative flex flex-col h-full bg-emerald-50/20 backdrop-blur-lg border border-emerald-100/50 rounded-[24px] overflow-hidden shadow-[0_8px_32px_rgba(5,150,105,0.03)] transition-all duration-500 hover:shadow-[0_16px_48px_rgba(5,150,105,0.08)] hover:-translate-y-1 hover:bg-white opacity-0 translate-y-8" data-variant="{{ variant }}">
    <a href="{{ postUrlPrefix }}/{{ post.slug }}" class="absolute inset-0 z-10" aria-label="Đọc bài viết: {{ post.title }}"></a>

    <div class="relative overflow-hidden aspect-[4/3] bg-emerald-100/20 rounded-t-[24px]">
        {% if post.thumbnail %}
            <img src="{{ post.thumbnail }}" alt="{{ post.title }}" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy">
        {% else %}
            <div class="w-full h-full flex items-center justify-center text-emerald-200">
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </div>
        {% endif %}
        <div class="absolute inset-0 bg-gradient-to-t from-emerald-900/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-[10px] font-medium text-emerald-700 shadow-sm opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-2 group-hover:translate-y-0 flex items-center gap-1.5">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
            <span>Khám phá</span>
        </div>
    </div>

    <div class="flex flex-col flex-grow p-6">
        <div class="flex items-center justify-between mb-4 text-[10px] sm:text-xs tracking-widest uppercase font-medium">
            {% if post.category %}
                <span class="text-emerald-600 truncate pr-2 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    {{ post.category.title }}
                </span>
            {% endif %}
            {% if post.publishedAt %}
                <time class="text-slate-400 shrink-0">{{ post.publishedAt | date: "%d.%m.%Y" }}</time>
            {% endif %}
        </div>

        <h3 class="font-serif text-lg sm:text-xl text-slate-800 leading-snug mb-3 group-hover:text-emerald-700 transition-colors duration-300 line-clamp-2">
            {{ post.title }}
        </h3>

        {% if post.excerpt %}
            <p class="text-slate-500 text-sm leading-relaxed line-clamp-2 sm:line-clamp-3 mb-5 flex-grow font-light">
                {{ post.excerpt }}
            </p>
        {% endif %}

        <div class="mt-auto pt-4 border-t border-emerald-100/50 flex items-center text-sm font-medium text-slate-700 group-hover:text-emerald-600 transition-colors">
            <span class="relative overflow-hidden">
                <span class="block transition-transform duration-300 group-hover:-translate-y-full">Đọc bài viết</span>
                <span class="absolute inset-0 block transition-transform duration-300 translate-y-full group-hover:translate-y-0 text-emerald-600">Đọc bài viết</span>
            </span>
            <svg class="w-4 h-4 ml-2 transform transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </div>
    </div>
</article>