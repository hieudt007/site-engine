<div class="product-media-gallery flex flex-col gap-4 lg:gap-6 w-full">
    <!-- Khối ảnh chính (Main Image) phong cách thiên nhiên -->
    <div class="main-image-container relative w-full aspect-[4/5] lg:aspect-[3/4] rounded-[24px] overflow-hidden bg-emerald-50/40 backdrop-blur-md border border-emerald-100 shadow-[0_8px_32px_rgba(5,150,105,0.08)] group">
        <img
            id="gallery-main-image"
            src="{{ product.imageUrls[0] }}"
            alt="{{ product.name | escape }}"
            class="w-full h-full object-cover object-center transition-all duration-700 ease-out group-hover:scale-105"
        >
        <!-- Lớp phủ ánh sáng tạo cảm giác hữu cơ mềm mại -->
        <div class="absolute inset-0 bg-gradient-to-tr from-emerald-900/5 via-transparent to-white/30 pointer-events-none mix-blend-overlay"></div>
    </div>

    <!-- Danh sách ảnh nhỏ (Thumbnails) -->
    <div class="thumbnails-container flex gap-3 overflow-x-auto pb-2 snap-x snap-mandatory scroll-smooth hide-scrollbar">
        {% for image in product.imageUrls %}
            <button
                type="button"
                class="thumbnail-trigger relative flex-shrink-0 w-20 h-24 sm:w-24 sm:h-32 rounded-[20px] overflow-hidden snap-center cursor-pointer transition-all duration-300 border-2 {% if forloop.first %}border-emerald-600 shadow-md opacity-100{% else %}border-transparent opacity-60 hover:opacity-100 hover:border-emerald-400/50{% endif %}"
                data-image-url="{{ image }}"
                aria-label="Xem ảnh {{ forloop.index }} của {{ product.name | escape }}"
            >
                <img
                    src="{{ image }}"
                    alt="{{ product.name | escape }} - Thumbnail {{ forloop.index }}"
                    class="w-full h-full object-cover object-center"
                    loading="lazy"
                >
                <!-- Lớp phủ tối nhẹ cho ảnh chưa chọn -->
                <div class="thumbnail-overlay absolute inset-0 bg-emerald-900/5 transition-opacity duration-300 {% if forloop.first %}opacity-0{% else %}opacity-100 group-hover:opacity-0{% endif %}"></div>
            </button>
        {% endfor %}
    </div>
</div>