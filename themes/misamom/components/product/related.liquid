{% if products and products.size > 0 %}
<section class="related-products-section py-20 md:py-32 relative z-10 overflow-hidden bg-emerald-50/30">
    <!-- Organic Background Blob -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div class="absolute -top-[20%] -right-[10%] w-[500px] h-[500px] rounded-full bg-emerald-100/40 blur-3xl opacity-60 animate-blob"></div>
        <div class="absolute -bottom-[20%] -left-[10%] w-[600px] h-[600px] rounded-full bg-teal-50/40 blur-3xl opacity-60 animate-blob animation-delay-2000"></div>
    </div>

    <div class="container mx-auto px-4 max-w-7xl relative z-10">
        <div class="related-section-header text-center mb-12 md:mb-20 flex flex-col items-center">
            <span class="text-emerald-600 font-medium tracking-widest uppercase text-xs mb-3 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
                Gợi ý cho bạn
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
            </span>
            <h2 class="text-3xl md:text-5xl font-serif text-emerald-950 mb-6">{{ title }}</h2>
            <div class="w-16 h-1 bg-gradient-to-r from-emerald-200 via-emerald-400 to-emerald-200 rounded-full"></div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-8">
            {% for prod in products %}
                <a href="{{ productUrlPrefix }}{{ prod.slug }}" class="related-product-card group block relative rounded-[24px] overflow-hidden bg-white border border-emerald-100/50 shadow-sm hover:shadow-[0_20px_40px_-15px_rgba(5,150,105,0.15)] transition-all duration-500 transform hover:-translate-y-1">
                    <div class="aspect-[4/5] overflow-hidden bg-emerald-50/50 relative rounded-t-[24px]">
                        {% if prod.thumbnail %}
                            <img src="{{ prod.thumbnail }}" alt="{{ prod.name }}" class="w-full h-full object-cover object-center transition-transform duration-1000 group-hover:scale-110" loading="lazy">
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center text-emerald-800/40 font-sans text-sm bg-emerald-50">Chưa có ảnh</div>
                        {% endif %}
                        
                        <!-- Hover Overlay -->
                        <div class="absolute inset-0 bg-emerald-950/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center backdrop-blur-[2px]">
                            <span class="bg-white text-emerald-900 px-6 py-3 rounded-full font-sans text-xs font-semibold tracking-wider uppercase transform translate-y-8 group-hover:translate-y-0 transition-all duration-500 shadow-[0_8px_20px_rgba(0,0,0,0.1)] flex items-center gap-2">
                                Khám phá
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </span>
                        </div>
                    </div>
                    
                    <div class="p-5 md:p-6 text-center bg-white relative z-10">
                        <h3 class="font-sans font-medium text-emerald-950 text-sm md:text-base line-clamp-2 mb-3 group-hover:text-emerald-600 transition-colors duration-300">{{ prod.name }}</h3>
                        <div class="font-serif font-semibold text-emerald-800 text-base md:text-lg">
                            {{ prod.price }}
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}