{% layout "layout" %}
{% block content %}
<main class="pt-24 pb-20 bg-[#ECFDF5] min-h-screen font-sans text-[#064E3B]">
    <!-- Hero Section -->
    <section class="container mx-auto px-4 text-center mb-12">
        <h1 class="font-serif text-4xl md:text-5xl text-[#064E3B] mb-4 fade-up-item">Tạp Chí Làm Đẹp Thiên Nhiên</h1>
        <p class="font-sans text-gray-600 max-w-2xl mx-auto text-lg fade-up-item">Khám phá bí quyết chăm sóc da, xu hướng làm đẹp hữu cơ và câu chuyện đằng sau những nguyên liệu tinh túy nhất.</p>
    </section>

    <!-- Search & Filter -->
    <section class="container mx-auto px-4 mb-12 fade-up-item">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-white p-6 rounded-[24px] shadow-[0_8px_32px_rgba(0,0,0,0.04)] border border-[#A7F3D0]">
            <!-- Search -->
            <div class="relative w-full md:w-1/3">
                <input type="text" placeholder="Tìm kiếm bài viết..." class="w-full pl-11 pr-4 py-3 rounded-full border border-gray-200 focus:outline-none focus:border-[#059669] focus:ring-1 focus:ring-[#059669] font-sans bg-[#F8FAFC] transition-all text-sm text-[#064E3B]">
                <svg class="w-5 h-5 text-gray-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>

            <!-- Categories -->
            <div class="w-full md:w-2/3 overflow-x-auto hide-scrollbar">
                <div class="flex items-center md:justify-end gap-3 min-w-max category-filters">
                    <a href="#" class="px-5 py-2.5 rounded-full bg-[#059669] text-white font-sans text-sm transition-colors">Tất cả</a>
                    <a href="#" class="px-5 py-2.5 rounded-full bg-[#E8F1F3] text-[#64748B] font-sans text-sm hover:bg-[#A7F3D0] hover:text-[#064E3B] transition-colors">Chăm sóc da</a>
                    <a href="#" class="px-5 py-2.5 rounded-full bg-[#E8F1F3] text-[#64748B] font-sans text-sm hover:bg-[#A7F3D0] hover:text-[#064E3B] transition-colors">Thành phần tự nhiên</a>
                    <a href="#" class="px-5 py-2.5 rounded-full bg-[#E8F1F3] text-[#64748B] font-sans text-sm hover:bg-[#A7F3D0] hover:text-[#064E3B] transition-colors">Lối sống xanh</a>
                    <a href="#" class="px-5 py-2.5 rounded-full bg-[#E8F1F3] text-[#64748B] font-sans text-sm hover:bg-[#A7F3D0] hover:text-[#064E3B] transition-colors">Sự kiện</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Blog Grid -->
    <section class="container mx-auto px-4 mb-16">
        {% if posts and posts.size > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for post in posts %}
                    <article class="group bg-white rounded-[24px] overflow-hidden shadow-sm hover:shadow-[0_8px_32px_rgba(0,0,0,0.08)] transition-all duration-500 border border-[#A7F3D0] fade-up-item flex flex-col h-full relative">
                        <a href="/blog/{{ post.slug }}" class="block relative overflow-hidden aspect-[4/3] rounded-t-[24px]">
                            {% if post.coverImage %}
                                <img src="{{ post.coverImage }}" alt="{{ post.title }}" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out">
                            {% else %}
                                <div class="w-full h-full bg-[#E8F1F3] flex items-center justify-center transform group-hover:scale-105 transition-transform duration-700 ease-out">
                                    <svg class="w-12 h-12 text-[#A7F3D0]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                </div>
                            {% endif %}
                            
                            <!-- Category Badge -->
                            {% if post.categories and post.categories.size > 0 %}
                                <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-[#059669] px-4 py-1.5 text-xs font-semibold uppercase tracking-wider rounded-full shadow-sm">
                                    {{ post.categories[0] }}
                                </span>
                            {% else %}
                                <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-[#059669] px-4 py-1.5 text-xs font-semibold uppercase tracking-wider rounded-full shadow-sm">
                                    Làm đẹp
                                </span>
                            {% endif %}
                        </a>
                        <div class="p-6 flex flex-col flex-grow">
                            <div class="text-xs text-[#64748B] font-sans mb-3 uppercase tracking-widest flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                {{ post.publishedAt | date: "%d/%m/%Y" | default: "Mới nhất" }}
                            </div>
                            <h2 class="font-serif text-xl text-[#064E3B] mb-3 group-hover:text-[#059669] transition-colors line-clamp-2 leading-snug">
                                <a href="/blog/{{ post.slug }}">{{ post.title }}</a>
                            </h2>
                            <p class="text-gray-600 font-sans text-sm line-clamp-3 mb-6 flex-grow leading-relaxed">
                                {{ post.excerpt | default: "Khám phá chi tiết bài viết này để hiểu rõ hơn về bí quyết làm đẹp từ thiên nhiên..." }}
                            </p>
                            <a href="/blog/{{ post.slug }}" class="inline-flex items-center text-sm font-semibold text-[#059669] group-hover:text-[#10B981] transition-colors mt-auto uppercase tracking-wide">
                                Đọc tiếp
                                <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                            </a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-20 bg-white rounded-[24px] border border-[#A7F3D0] fade-up-item shadow-[0_8px_32px_rgba(0,0,0,0.04)]">
                <svg class="w-16 h-16 text-[#A7F3D0] mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
                <p class="font-serif text-2xl text-[#064E3B] mb-2">Chưa có bài viết nào</p>
                <p class="font-sans text-gray-500">Chúng tôi đang cập nhật những nội dung mới nhất về làm đẹp hữu cơ. Vui lòng quay lại sau.</p>
            </div>
        {% endif %}
    </section>

    <!-- Pagination -->
    {% if hasPrev or hasNext %}
        <section class="container mx-auto px-4 fade-up-item">
            <div class="flex justify-center border-t border-[#A7F3D0] pt-10">
                {% render "components/common/pagination", basePath: "/blog", hasPrev: hasPrev, hasNext: hasNext, prevPage: prevPage, nextPage: nextPage %}
            </div>
        </section>
    {% endif %}
</main>
{% endblock %}