{% comment %}
@description: Trang tinh (Gioi thieu, Lien he...).
@required_substrings: {% layout "layout" %}, {% block content %}, {% endblock %}, page.title, page.body
@required_ids: 
@notes: page.body la HTML da sanitize, render RAW.
{% endcomment %}
{% layout "layout" %}
{% block content %}
<main class="relative bg-[#FAFAF9] min-h-screen pt-32 pb-24 overflow-hidden selection:bg-[#059669] selection:text-white">
    <!-- Background Organic Blobs -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-[#ECFDF5] rounded-full mix-blend-multiply filter blur-[80px] opacity-70 animate-blob"></div>
        <div class="absolute top-[20%] right-[-5%] w-[30%] h-[30%] bg-[#E8F3F1] rounded-full mix-blend-multiply filter blur-[80px] opacity-70 animate-blob animation-delay-2000"></div>
    </div>

    <!-- Hero Section -->
    <header class="relative container mx-auto px-4 sm:px-6 lg:px-8 mb-16 text-center z-10 animate-fade-up">
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-[#064E3B] mb-6 tracking-tight leading-tight">
            {{ page.title }}
        </h1>
        <div class="w-16 h-1.5 bg-[#059669] mx-auto rounded-full opacity-80"></div>
    </header>

    <!-- Content Section -->
    <article class="relative container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl z-10 animate-fade-up" style="animation-delay: 150ms;">
        <div class="page-content-wrapper bg-white/80 backdrop-blur-xl rounded-[24px] shadow-[0_8px_32px_rgba(5,150,105,0.05)] border border-[#A7F3D0]/30 p-8 md:p-12 lg:p-16">
            {{ page.body }}
        </div>
    </article>
</main>
{% endblock %}