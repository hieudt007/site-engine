{% layout "layout" %}
{% block content %}
<!-- Hero Section -->
<section class="relative h-[90vh] min-h-[600px] flex items-center justify-center overflow-hidden">
    <img src="https://images.unsplash.com/photo-1556228578-0d85b1a4d571?q=80&w=2000&auto=format&fit=crop" alt="Mỹ phẩm thiên nhiên cao cấp" class="absolute inset-0 w-full h-full object-cover zoom-out-anim" />
    <div class="absolute inset-0 bg-emerald-950/40"></div>
    <div class="relative z-10 text-center px-4 max-w-3xl mx-auto flex flex-col items-center">
        <div class="glass-panel p-10 md:p-16 rounded-[2.5rem] border border-white/20 shadow-2xl backdrop-blur-md bg-white/10 text-white transform translate-y-8 opacity-0 animate-fade-up">
            <span class="uppercase tracking-[0.2em] text-sm mb-4 block text-emerald-50 font-sans">Khám Phá Vẻ Đẹp Tự Nhiên</span>
            <h1 class="font-serif text-5xl md:text-7xl mb-6 leading-tight">Tinh Hoa<br/>Từ Thiên Nhiên</h1>
            <p class="font-sans text-lg md:text-xl text-emerald-50 mb-8 max-w-xl mx-auto font-light">Chăm sóc làn da của bạn với những nguyên liệu hữu cơ thuần khiết nhất, mang lại vẻ rạng rỡ từ sâu bên trong.</p>
            <a href="/collections/all" class="inline-block bg-emerald-600 text-white px-10 py-4 uppercase tracking-widest text-sm font-medium hover:bg-emerald-700 hover:-translate-y-1 transition-all duration-300 rounded-full shadow-lg hover:shadow-emerald-900/20">Mua Sắm Ngay</a>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="py-24 bg-emerald-50/50">
    <div class="container mx-auto px-4 max-w-7xl">
        <div class="text-center mb-16">
            <h2 class="font-serif text-4xl text-emerald-900 mb-4">Danh Mục Nổi Bật</h2>
            <div class="w-16 h-[1px] bg-emerald-600 mx-auto"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Category 1 -->
            <a href="/collections/skincare" class="group relative block h-[450px] overflow-hidden rounded-[2rem] shadow-sm hover:shadow-xl transition-shadow duration-500">
                <img src="https://images.unsplash.com/photo-1617897903246-719242758050?q=80&w=800&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="Chăm Sóc Da" />
                <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/80 via-emerald-900/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-center translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="font-serif text-3xl text-white mb-2">Chăm Sóc Da</h3>
                    <span class="text-emerald-50 uppercase tracking-widest text-xs border-b border-emerald-100/40 pb-1 font-medium">Khám phá</span>
                </div>
            </a>
            <!-- Category 2 -->
            <a href="/collections/bodycare" class="group relative block h-[450px] overflow-hidden rounded-[2rem] shadow-sm hover:shadow-xl transition-shadow duration-500">
                <img src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?q=80&w=800&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="Chăm Sóc Cơ Thể" />
                <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/80 via-emerald-900/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-center translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="font-serif text-3xl text-white mb-2">Chăm Sóc Cơ Thể</h3>
                    <span class="text-emerald-50 uppercase tracking-widest text-xs border-b border-emerald-100/40 pb-1 font-medium">Khám phá</span>
                </div>
            </a>
            <!-- Category 3 -->
            <a href="/collections/fragrance" class="group relative block h-[450px] overflow-hidden rounded-[2rem] shadow-sm hover:shadow-xl transition-shadow duration-500">
                <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?q=80&w=800&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="Nước Hoa" />
                <div class="absolute inset-0 bg-gradient-to-t from-emerald-950/80 via-emerald-900/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-center translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <h3 class="font-serif text-3xl text-white mb-2">Hương Thơm</h3>
                    <span class="text-emerald-50 uppercase tracking-widest text-xs border-b border-emerald-100/40 pb-1 font-medium">Khám phá</span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- New Products Section -->
<section class="py-24 bg-white">
    <div class="container mx-auto px-4 max-w-7xl">
        <div class="flex justify-between items-end mb-12">
            <div>
                <h2 class="font-serif text-4xl text-emerald-900 mb-4">Bộ Sưu Tập Mới</h2>
                <div class="w-16 h-[1px] bg-emerald-600"></div>
            </div>
            <a href="/collections/new" class="hidden md:inline-block uppercase tracking-widest text-sm text-emerald-800 border-b border-emerald-800 pb-1 hover:text-emerald-600 hover:border-emerald-600 transition-colors font-medium">Xem tất cả</a>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-12 md:gap-x-8">
            {% if products and products.size > 0 %}
                {% for product in products limit: 4 %}
                    <div class="product-card group cursor-pointer scroll-animate">
                        <div class="relative aspect-[3/4] overflow-hidden bg-emerald-50/30 mb-5 rounded-[1.5rem] border border-emerald-100/50 shadow-sm hover:shadow-md transition-shadow">
                            {% if product.imageUrls and product.imageUrls.size > 0 %}
                                <img src="{{ product.imageUrls[0] }}" alt="{{ product.name }}" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 group-hover:opacity-0" />
                                {% if product.imageUrls.size > 1 %}
                                    <img src="{{ product.imageUrls[1] }}" alt="{{ product.name }} hover" class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700 group-hover:opacity-100" />
                                {% else %}
                                    <img src="{{ product.imageUrls[0] }}" alt="{{ product.name }} scale" class="absolute inset-0 w-full h-full object-cover opacity-0 transition-transform duration-1000 scale-105 group-hover:opacity-100" />
                                {% endif %}
                            {% else %}
                                <div class="absolute inset-0 flex items-center justify-center text-emerald-300 font-sans">No Image</div>
                            {% endif %}
                            
                            <!-- Badges -->
                            {% if product.salePrice and product.salePrice < product.price %}
                                <div class="absolute top-3 left-3 bg-red-600 text-white text-[10px] uppercase tracking-widest px-3 py-1 rounded-full font-medium">Sale</div>
                            {% endif %}

                            <!-- Quick Action Overlay -->
                            <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out z-10 flex justify-center">
                                <button class="add-to-cart-quick w-full max-w-[95%] bg-emerald-600/95 backdrop-blur-sm text-white uppercase tracking-widest text-xs py-3.5 px-4 rounded-full font-medium hover:bg-emerald-700 transition-all shadow-lg flex items-center justify-center gap-2">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                                    Thêm vào giỏ
                                </button>
                            </div>
                        </div>
                        <div class="text-center px-2">
                            <h3 class="font-serif text-lg text-emerald-900 mb-2 truncate group-hover:text-emerald-600 transition-colors">{{ product.name }}</h3>
                            <div class="flex justify-center items-center gap-3 font-sans">
                                {% if product.salePrice and product.salePrice < product.price %}
                                    <span class="text-emerald-700 font-medium">{{ product.salePrice | money }}</span>
                                    <span class="text-emerald-900/40 line-through text-sm">{{ product.price | money }}</span>
                                {% else %}
                                    <span class="text-emerald-700 font-medium">{{ product.price | money }}</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <!-- Fallback Dummy Products -->
                {% for i in (1..4) %}
                    <div class="product-card group cursor-pointer scroll-animate">
                        <div class="relative aspect-[3/4] overflow-hidden bg-emerald-50/30 mb-5 rounded-[1.5rem] border border-emerald-100/50 shadow-sm hover:shadow-md transition-shadow">
                            <img src="https://placehold.co/600x800/ECFDF5/064E3B?text=Premium+Product+{{ i }}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" alt="Dummy Product" />
                            <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out z-10 flex justify-center">
                                <button class="add-to-cart-quick w-full max-w-[95%] bg-emerald-600/95 backdrop-blur-sm text-white uppercase tracking-widest text-xs py-3.5 px-4 rounded-full font-medium hover:bg-emerald-700 transition-all shadow-lg flex items-center justify-center gap-2">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                                    Thêm vào giỏ
                                </button>
                            </div>
                        </div>
                        <div class="text-center px-2">
                            <h3 class="font-serif text-lg text-emerald-900 mb-2 group-hover:text-emerald-600 transition-colors">Tinh Chất Phục Hồi Thảo Mộc {{ i }}</h3>
                            <span class="text-emerald-700 font-medium font-sans">1,200,000₫</span>
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
        <div class="mt-10 text-center md:hidden">
            <a href="/collections/new" class="inline-block uppercase tracking-widest text-sm text-emerald-800 border-b border-emerald-800 pb-1 font-medium">Xem tất cả</a>
        </div>
    </div>
</section>

<!-- Brand Story Banner -->
<section class="py-24 bg-emerald-50 relative overflow-hidden">
    <div class="container mx-auto px-4 max-w-7xl relative z-10">
        <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-24">
            <div class="w-full md:w-1/2 relative scroll-animate">
                <div class="aspect-[4/5] rounded-[2rem] rounded-tr-[5rem] rounded-bl-[5rem] overflow-hidden shadow-2xl relative z-10">
                    <img src="https://images.unsplash.com/photo-1615397323944-593b482701e8?q=80&w=1000&auto=format&fit=crop" alt="Thành phần tự nhiên" class="w-full h-full object-cover" />
                </div>
                <!-- Decorative element -->
                <div class="absolute -bottom-10 -right-10 w-64 h-64 bg-emerald-200 rounded-full mix-blend-multiply filter blur-3xl opacity-60 animate-blob"></div>
            </div>
            <div class="w-full md:w-1/2 scroll-animate">
                <span class="uppercase tracking-[0.2em] text-sm mb-4 block text-emerald-600 font-medium">Câu Chuyện Thương Hiệu</span>
                <h2 class="font-serif text-4xl md:text-5xl text-emerald-900 mb-6 leading-tight">Vẻ Đẹp Đích Thực <br/>Từ Sự Thuần Khiết</h2>
                <p class="text-emerald-800/80 mb-8 text-lg font-light leading-relaxed font-sans">Chúng tôi tin rằng thiên nhiên nắm giữ chìa khóa cho làn da khỏe mạnh. Mỗi sản phẩm là sự kết tinh của những thành phần hữu cơ tinh túy nhất, được lựa chọn cẩn thận để mang lại hiệu quả tối ưu mà không làm tổn hại đến sự cân bằng tự nhiên của làn da.</p>
                <a href="/pages/about" class="inline-block border border-emerald-600 text-emerald-700 px-10 py-4 uppercase tracking-widest text-sm font-medium hover:bg-emerald-600 hover:text-white transition-colors duration-300 rounded-full">Khám Phá Thêm</a>
            </div>
        </div>
    </div>
</section>

<!-- Blog Section -->
<section class="py-24 bg-white">
    <div class="container mx-auto px-4 max-w-7xl">
        <div class="text-center mb-16">
            <h2 class="font-serif text-4xl text-emerald-900 mb-4">Góc Làm Đẹp</h2>
            <div class="w-16 h-[1px] bg-emerald-600 mx-auto"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            {% if posts and posts.size > 0 %}
                {% for post in posts limit: 3 %}
                    <article class="group cursor-pointer scroll-animate">
                        <div class="relative aspect-[4/3] overflow-hidden rounded-[1.5rem] mb-6 shadow-sm hover:shadow-lg transition-shadow duration-500">
                            {% if post.coverImage %}
                                <img src="{{ post.coverImage }}" alt="{{ post.title }}" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                            {% else %}
                                <div class="w-full h-full bg-emerald-50 flex items-center justify-center font-sans text-emerald-900/40">No Image</div>
                            {% endif %}
                            <div class="absolute top-4 left-4 bg-white/95 backdrop-blur px-4 py-1.5 text-[10px] uppercase tracking-widest text-emerald-800 rounded-full font-medium shadow-sm">
                                {{ post.publishedAt | date: "%d/%m/%Y" }}
                            </div>
                        </div>
                        <div>
                            <h3 class="font-serif text-2xl text-emerald-900 mb-3 group-hover:text-emerald-600 transition-colors line-clamp-2">{{ post.title }}</h3>
                            <p class="text-emerald-900/60 mb-5 line-clamp-3 font-light font-sans">{{ post.excerpt }}</p>
                            <a href="/blogs/{{ post.slug }}" class="inline-flex items-center text-xs uppercase tracking-widest text-emerald-800 font-medium group-hover:text-emerald-600 transition-colors">
                                Đọc tiếp
                                <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                            </a>
                        </div>
                    </article>
                {% endfor %}
            {% else %}
                <!-- Fallback Dummy Posts -->
                {% for i in (1..3) %}
                    <article class="group cursor-pointer scroll-animate">
                        <div class="relative aspect-[4/3] overflow-hidden rounded-[1.5rem] mb-6 shadow-sm hover:shadow-lg transition-shadow duration-500">
                            <img src="https://placehold.co/800x600/ECFDF5/064E3B?text=Beauty+Blog+{{ i }}" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" alt="Dummy Post" />
                            <div class="absolute top-4 left-4 bg-white/95 backdrop-blur px-4 py-1.5 text-[10px] uppercase tracking-widest text-emerald-800 rounded-full font-medium shadow-sm">
                                20/11/2023
                            </div>
                        </div>
                        <div>
                            <h3 class="font-serif text-2xl text-emerald-900 mb-3 group-hover:text-emerald-600 transition-colors">Bí Quyết Chăm Sóc Da Mùa Đông Cho Làn Da Nhạy Cảm</h3>
                            <p class="text-emerald-900/60 mb-5 line-clamp-3 font-light font-sans">Khám phá những bước dưỡng da thiết yếu giúp bảo vệ và phục hồi làn da nhạy cảm trong những ngày thời tiết hanh khô, mang lại vẻ rạng rỡ bất chấp thời tiết.</p>
                            <a href="#" class="inline-flex items-center text-xs uppercase tracking-widest text-emerald-800 font-medium group-hover:text-emerald-600 transition-colors">
                                Đọc tiếp
                                <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                            </a>
                        </div>
                    </article>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</section>

<!-- Instagram Feed Mockup -->
<section class="border-t border-emerald-100 bg-emerald-50/30 py-20">
    <div class="container mx-auto px-4 text-center">
         <h2 class="font-serif text-3xl text-emerald-900 mb-3">@NatureCosmetics</h2>
         <p class="text-emerald-900/60 mb-10 font-light font-sans">Theo dõi chúng tôi trên Instagram để cập nhật xu hướng làm đẹp</p>
         <div class="flex justify-center gap-4 flex-wrap">
             <div class="w-32 h-32 md:w-48 md:h-48 overflow-hidden rounded-[1.5rem] shadow-sm"><img src="https://images.unsplash.com/photo-1556228720-192a6af4e184?q=80&w=400&auto=format&fit=crop" class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" alt="Instagram 1"/></div>
             <div class="w-32 h-32 md:w-48 md:h-48 overflow-hidden rounded-[1.5rem] shadow-sm"><img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=400&auto=format&fit=crop" class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" alt="Instagram 2"/></div>
             <div class="w-32 h-32 md:w-48 md:h-48 overflow-hidden rounded-[1.5rem] shadow-sm hidden sm:block"><img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?q=80&w=400&auto=format&fit=crop" class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" alt="Instagram 3"/></div>
             <div class="w-32 h-32 md:w-48 md:h-48 overflow-hidden rounded-[1.5rem] shadow-sm hidden md:block"><img src="https://images.unsplash.com/photo-1571781926291-c477eb31f7d8?q=80&w=400&auto=format&fit=crop" class="w-full h-full object-cover hover:scale-110 transition-transform duration-700" alt="Instagram 4"/></div>
         </div>
    </div>
</section>
{% endblock %}