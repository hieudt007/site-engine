{% comment %}
@description: Partial hien bang key-value cho truong tuy bien admin tu dat.
@required_substrings: fields
@required_ids: 
@notes: Nhan fields (object string->string, co the null/rong — PHAI tu an neu rong). Loop qua tung cap [key,value].
{% endcomment %}
{% if fields %}
<div class="custom-fields-wrapper w-full relative bg-white rounded-[24px] shadow-[0_8px_32px_rgba(5,150,105,0.04)] border border-emerald-100/50 overflow-hidden group/wrapper">
  <!-- Decorative Organic Blob -->
  <div class="absolute top-0 right-0 -mr-16 -mt-16 w-48 h-48 bg-emerald-50 rounded-full mix-blend-multiply filter blur-2xl opacity-60 transition-transform duration-700 group-hover/wrapper:scale-110 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 -ml-12 -mb-12 w-32 h-32 bg-emerald-50/80 rounded-full mix-blend-multiply filter blur-xl opacity-40 pointer-events-none"></div>

  <dl class="relative z-10 divide-y divide-emerald-100/50">
    {% for field in fields %}
      <div class="custom-field-row group p-5 sm:p-6 flex flex-col sm:flex-row sm:gap-8 hover:bg-emerald-50/40 transition-colors duration-400">
        <dt class="text-xs md:text-sm font-semibold text-emerald-800/80 uppercase tracking-[0.15em] sm:w-1/3 shrink-0 flex items-center gap-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
          {{ field[0] }}
        </dt>
        <dd class="mt-2 text-base text-gray-700 sm:mt-0 sm:w-2/3 leading-relaxed font-light">
          {{ field[1] }}
        </dd>
      </div>
    {% endfor %}
  </dl>
</div>
{% endif %}