<!-- Newsletter Section -->
<section class="pb-20 md:pb-32 bg-white px-6">
    <div class="max-w-[1000px] mx-auto bg-brand-light/50 rounded-[40px] p-10 md:p-16 relative overflow-hidden border border-brand/10 shadow-[0_20px_40px_rgba(67,160,71,0.05)]">
        <!-- Decorative Elements -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-brand/10 rounded-full blur-3xl transform translate-x-1/2 -translate-y-1/2"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-teal-100/50 rounded-full blur-3xl transform -translate-x-1/2 translate-y-1/2"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row items-center gap-10 md:gap-16">
            <div class="w-full md:w-1/2 text-center md:text-left">
                <span class="inline-block py-1 px-3 rounded-full bg-white text-brand text-xs font-bold tracking-widest uppercase mb-4 shadow-sm">
                    Newsletter
                </span>
                <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4 leading-tight">
                    Nhận ưu đãi <br class="hidden md:block"> <span class="text-brand">mới nhất</span>
                </h2>
                <p class="text-slate-600">Đăng ký email để nhận mã giảm giá 10% cho đơn hàng đầu tiên và các bí quyết làm đẹp từ chuyên gia.</p>
            </div>
            
            <div class="w-full md:w-1/2">
                <form class="flex flex-col sm:flex-row gap-3">
                    <div class="relative flex-grow">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        </div>
                        <input type="email" placeholder="Nhập email của bạn..." class="w-full pl-11 pr-4 py-4 rounded-full border-none shadow-[0_4px_20px_rgba(0,0,0,0.04)] focus:ring-2 focus:ring-brand focus:outline-none transition-shadow text-slate-700 bg-white placeholder-slate-400">
                    </div>
                    <button type="submit" class="bg-brand hover:bg-brand-hover text-white font-semibold py-4 px-8 rounded-full transition-all duration-300 shadow-[0_8px_20px_rgba(67,160,71,0.2)] hover:shadow-[0_12px_24px_rgba(67,160,71,0.3)] hover:-translate-y-1 flex-shrink-0 whitespace-nowrap">
                        Đăng ký ngay
                    </button>
                </form>
                <p class="text-xs text-slate-500 mt-4 text-center md:text-left">
                    Bằng việc đăng ký, bạn đồng ý với <a href="/pages/privacy" class="text-brand hover:underline">Chính sách bảo mật</a> của chúng tôi.
                </p>
            </div>
        </div>
    </div>
</section>
