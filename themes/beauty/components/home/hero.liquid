<!-- Hero Section -->
<section class="relative bg-brand-light overflow-hidden min-h-[90vh] flex items-center">
    <!-- Abstract Background Shapes -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
        <div class="absolute -top-[20%] -left-[10%] w-[50vw] h-[50vw] rounded-full bg-brand/10 blur-[120px] mix-blend-multiply animate-blob"></div>
        <div class="absolute top-[20%] -right-[10%] w-[60vw] h-[60vw] rounded-full bg-teal-100/40 blur-[120px] mix-blend-multiply animate-blob animation-delay-2000"></div>
        <div class="absolute -bottom-[20%] left-[20%] w-[40vw] h-[40vw] rounded-full bg-brand-light/60 blur-[100px] mix-blend-multiply animate-blob animation-delay-4000"></div>
    </div>
    
    <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-20 lg:py-32 w-full flex flex-col lg:flex-row items-center gap-16">
        
        <!-- Left Side: Content -->
        <div class="w-full lg:w-1/2 flex flex-col text-center lg:text-left pt-10 lg:pt-0">
            <span class="inline-block py-1.5 px-4 rounded-full bg-brand/10 text-brand text-sm font-medium tracking-wide mb-6 w-max mx-auto lg:mx-0 shadow-sm border border-brand/20">
                Misamom Natural Skincare
            </span>
            
            <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-bold text-slate-900 leading-[1.15] mb-6">
                Chăm sóc làn da mẹ bầu <br class="hidden sm:block">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand to-teal-600">một cách an toàn</span>
            </h1>
            
            <p class="text-lg sm:text-xl text-slate-600 mb-10 font-light leading-relaxed max-w-xl mx-auto lg:mx-0">
                Mỹ phẩm thiên nhiên dành riêng cho mẹ bầu, mẹ sau sinh và làn da nhạy cảm. Xinh đẹp - An toàn - Hiệu quả.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-12">
                <a href="/products" class="inline-flex items-center justify-center bg-brand hover:bg-brand-hover text-white font-medium py-4 px-10 rounded-full transition-all duration-300 shadow-[0_8px_24px_rgba(67,160,71,0.25)] hover:shadow-[0_12px_32px_rgba(67,160,71,0.4)] hover:-translate-y-1">
                    Mua ngay
                    <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
                <a href="#contact" class="inline-flex items-center justify-center bg-white text-slate-800 font-medium py-4 px-10 rounded-full border border-slate-200 transition-all duration-300 hover:border-brand hover:text-brand shadow-sm hover:shadow-md hover:-translate-y-1">
                    Tư vấn miễn phí
                </a>
            </div>
            
            <!-- Trust Badges -->
            <div class="grid grid-cols-2 gap-y-4 gap-x-2 text-left w-max mx-auto lg:mx-0">
                <div class="flex items-center gap-2">
                    <div class="w-5 h-5 rounded-full bg-brand/10 flex items-center justify-center text-brand flex-shrink-0">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <span class="text-sm font-medium text-slate-700">Thành phần thiên nhiên</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-5 h-5 rounded-full bg-brand/10 flex items-center justify-center text-brand flex-shrink-0">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <span class="text-sm font-medium text-slate-700">Phù hợp mẹ bầu</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-5 h-5 rounded-full bg-brand/10 flex items-center justify-center text-brand flex-shrink-0">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <span class="text-sm font-medium text-slate-700">Da nhạy cảm</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-5 h-5 rounded-full bg-brand/10 flex items-center justify-center text-brand flex-shrink-0">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <span class="text-sm font-medium text-slate-700">Không Paraben</span>
                </div>
            </div>
        </div>
        
        <!-- Right Side: Imagery -->
        <div class="w-full lg:w-1/2 relative h-[500px] sm:h-[600px] lg:h-[700px] rounded-[40px] shadow-[0_32px_80px_rgba(0,0,0,0.08)]">
            <div class="absolute inset-0 rounded-[40px] overflow-hidden">
                <img src="https://images.unsplash.com/photo-1512495962002-86927d35dc66?q=80&w=1200&auto=format&fit=crop" alt="Misamom Pregnancy Skincare" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            </div>
            
            <!-- Floating Elements -->
            <div class="absolute top-10 -left-8 w-32 h-32 rounded-2xl bg-white/90 backdrop-blur-md shadow-[0_16px_40px_rgba(0,0,0,0.1)] p-3 animate-float border border-white/50 hidden md:block">
                <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=300&auto=format&fit=crop" alt="Serum" class="w-full h-full object-cover rounded-xl">
            </div>
            <div class="absolute bottom-20 -right-8 w-40 h-40 rounded-2xl bg-white/90 backdrop-blur-md shadow-[0_16px_40px_rgba(0,0,0,0.1)] p-3 animate-float animation-delay-2000 border border-white/50 hidden md:block">
                <img src="https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?q=80&w=400&auto=format&fit=crop" alt="Cream" class="w-full h-full object-cover rounded-xl">
            </div>
            
            <!-- Floating Leaf -->
            <div class="absolute -top-10 right-10 w-24 h-24 opacity-80 animate-float animation-delay-4000 pointer-events-none">
                <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M100 20 C40 20, 20 80, 20 100 C20 160, 80 180, 100 180 C160 180, 180 120, 180 100 C180 40, 120 20, 100 20 Z" fill="#66BB6A" opacity="0.4" filter="blur(10px)" />
                    <path d="M100 25 C45 25, 25 80, 25 100 C25 155, 80 175, 100 175 C155 175, 175 120, 175 100 C175 45, 120 25, 100 25 Z" fill="#E8F5E9" />
                </svg>
            </div>
        </div>
        
    </div>
</section>
