<!-- Ingredients Section -->
<section class="py-20 md:py-32 bg-brand-dark relative overflow-hidden">
    <!-- Abstract Shapes -->
    <div class="absolute inset-0 opacity-20 pointer-events-none">
        <svg class="absolute top-0 right-0 w-full h-full object-cover" viewBox="0 0 100 100" preserveAspectRatio="none">
            <path d="M0 100 C 20 0 50 0 100 100 Z" fill="url(#gradient)" opacity="0.1"></path>
            <defs>
                <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#43a047" />
                    <stop offset="100%" stop-color="#1b5e20" />
                </linearGradient>
            </defs>
        </svg>
    </div>

    <div class="max-w-[1200px] mx-auto px-6 relative z-10 text-white">
        <div class="text-center mb-16 md:mb-24 flex flex-col items-center">
            <span class="text-brand-light font-medium tracking-widest uppercase text-xs mb-3 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                Tinh hoa thiên nhiên
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
            </span>
            <h2 class="text-3xl md:text-4xl font-bold mb-6">Thành phần cốt lõi</h2>
            <div class="w-16 h-1 bg-gradient-to-r from-transparent via-brand-light to-transparent rounded-full"></div>
        </div>

        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
            <!-- Left Side: Infographic List -->
            <div class="w-full lg:w-1/2 space-y-8">
                <!-- Diếp Cá -->
                <div class="flex items-start gap-5 group">
                    <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:bg-brand transition-colors duration-300 shadow-[0_4px_20px_rgba(0,0,0,0.1)] border border-white/10 backdrop-blur-sm">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-brand-light mb-2">Diếp Cá</h3>
                        <p class="text-white/70 leading-relaxed text-sm md:text-base">Hỗ trợ trị mụn, làm dịu da viêm sưng, kháng khuẩn tự nhiên cực kỳ an toàn cho da nhạy cảm và thai kỳ.</p>
                    </div>
                </div>

                <!-- Dâu Tằm -->
                <div class="flex items-start gap-5 group">
                    <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:bg-brand transition-colors duration-300 shadow-[0_4px_20px_rgba(0,0,0,0.1)] border border-white/10 backdrop-blur-sm">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-brand-light mb-2">Dâu Tằm</h3>
                        <p class="text-white/70 leading-relaxed text-sm md:text-base">Dưỡng trắng tự nhiên, làm mờ vết thâm sạm và nám sau sinh, cải thiện sắc tố da an toàn.</p>
                    </div>
                </div>

                <!-- Tía Tô -->
                <div class="flex items-start gap-5 group">
                    <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:bg-brand transition-colors duration-300 shadow-[0_4px_20px_rgba(0,0,0,0.1)] border border-white/10 backdrop-blur-sm">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-brand-light mb-2">Tía Tô Tím</h3>
                        <p class="text-white/70 leading-relaxed text-sm md:text-base">Chứa hàm lượng lớn chống oxy hóa, làm sạch sâu lỗ chân lông, ngăn ngừa mụn và lão hóa hiệu quả.</p>
                    </div>
                </div>

                <!-- B5 & Niacinamide -->
                <div class="flex items-start gap-5 group">
                    <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:bg-brand transition-colors duration-300 shadow-[0_4px_20px_rgba(0,0,0,0.1)] border border-white/10 backdrop-blur-sm">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-brand-light mb-2">Vitamin B5 & Niacinamide</h3>
                        <p class="text-white/70 leading-relaxed text-sm md:text-base">Phục hồi hàng rào bảo vệ da, cấp ẩm sâu, se khít lỗ chân lông, mang lại làn da căng bóng mịn màng.</p>
                    </div>
                </div>
            </div>

            <!-- Right Side: Botanical Illustration -->
            <div class="w-full lg:w-1/2 relative h-[500px] lg:h-[700px] rounded-[40px]">
                <!-- Outer glow -->
                <div class="absolute inset-0 bg-brand-light/20 blur-[100px] rounded-full"></div>
                
                <div class="relative w-full h-full flex items-center justify-center z-10 p-6">
                    <img src="https://images.unsplash.com/photo-1542385151-efd9000785a0?q=80&w=1000&auto=format&fit=crop" alt="Botanical Ingredients" class="w-full h-full object-cover rounded-[32px] shadow-[0_32px_80px_rgba(0,0,0,0.4)] border border-white/20">
                    
                    <!-- Floating tags -->
                    <div class="absolute top-20 left-10 bg-white/90 backdrop-blur-md px-4 py-2 rounded-xl text-slate-800 font-medium text-sm shadow-xl animate-float border border-white/50 hidden md:block">
                        🌿 100% Thiên nhiên
                    </div>
                    <div class="absolute bottom-32 right-10 bg-white/90 backdrop-blur-md px-4 py-2 rounded-xl text-slate-800 font-medium text-sm shadow-xl animate-float animation-delay-2000 border border-white/50 hidden md:block">
                        ✨ Chuẩn y khoa
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
