<!-- Promotion Banner -->
<section class="py-10 md:py-20 bg-white">
    <div class="max-w-[1200px] mx-auto px-6">
        <div class="relative w-full rounded-[40px] overflow-hidden bg-brand-light">
            <!-- Background Image -->
            <div class="absolute inset-0">
                <img src="https://images.unsplash.com/photo-1571781526291-c477eb311dc6?q=80&w=2000&auto=format&fit=crop" alt="Summer Sale" class="w-full h-full object-cover opacity-60">
                <div class="absolute inset-0 bg-gradient-to-r from-brand-dark/80 to-transparent"></div>
            </div>

            <!-- Content -->
            <div class="relative z-10 p-10 md:p-20 max-w-2xl text-white">
                <span class="inline-block py-1.5 px-4 rounded-full bg-white/20 backdrop-blur-md text-white text-sm font-medium tracking-wide mb-6 border border-white/30">
                    Ưu đãi giới hạn
                </span>
                
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 leading-tight">
                    Summer Sale <br>
                    <span class="text-amber-300">Up to 40% OFF</span>
                </h2>
                
                <p class="text-white/90 text-lg md:text-xl mb-10 max-w-lg leading-relaxed">
                    Đón hè rạng rỡ cùng Misamom. Giảm giá sốc cho toàn bộ combo chăm sóc da toàn diện. Miễn phí vận chuyển toàn quốc.
                </p>
                
                <a href="/products" class="inline-flex items-center justify-center bg-white text-brand hover:bg-brand-light font-semibold py-4 px-10 rounded-full transition-all duration-300 shadow-[0_8px_24px_rgba(0,0,0,0.15)] hover:shadow-[0_12px_32px_rgba(0,0,0,0.2)] hover:-translate-y-1">
                    Săn Sale Ngay
                    <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
            </div>

            <!-- Floating Leaves -->
            <div class="absolute top-10 right-20 w-16 h-16 opacity-60 animate-float pointer-events-none">
                <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M100 25 C45 25, 25 80, 25 100 C25 155, 80 175, 100 175 C155 175, 175 120, 175 100 C175 45, 120 25, 100 25 Z" fill="#ffffff" />
                </svg>
            </div>
            <div class="absolute bottom-20 right-40 w-24 h-24 opacity-40 animate-float animation-delay-2000 pointer-events-none">
                <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M100 25 C45 25, 25 80, 25 100 C25 155, 80 175, 100 175 C155 175, 175 120, 175 100 C175 45, 120 25, 100 25 Z" fill="#ffffff" />
