{% comment %}
@description: Danh sach san pham, co phan trang.
@required_substrings: {% layout "layout" %}, {% block content %}, {% endblock %}, products, product.id, hasNext, hasPrev
@required_ids: 
@notes: products[] co id/name/imageUrls/price/salePrice. NÊN CÓ thêm: Sidebar hoặc Dropdown bộ lọc (Filter) cơ bản và Sắp xếp (Sort: giá, mới nhất).
{% endcomment %}
{% layout "layout" %}
{% block content %}
<section>
    <h1>...</h1>
    <div>
        {% if products and products.size > 0 %}
            {% for product in products %}
                <article>
                    <h2><a href="/products/{{ product.id }}">{{ product.name }}</a></h2>
                    ...
                </article>
            {% endfor %}
        {% endif %}
    </div>
    {% if hasPrev or hasNext %}
        {% render "components/common/pagination", basePath: "/products", hasPrev: hasPrev, hasNext: hasNext, prevPage: prevPage, nextPage: nextPage %}
    {% endif %}
</section>
{% endblock %}