{% comment %}
@description: Trang phan loai bai viet (danh muc hoac chu de).
@required_substrings: {% layout "layout" %}, {% block content %}, {% endblock %}, category.name, posts, category.customFields, categoryPath
@required_ids: 
@notes: Dung chung cho /danh-muc/:slug va /chu-de/:slug. category co name/excerpt/body/children[]/customFields. categoryPath la URL hien tai dung cho phan trang; backHref/backLabel va childPathPrefix co the duoc truyen theo ngu canh. PHAI giu {% render "custom-fields", fields: category.customFields %}.
{% endcomment %}
{% layout "layout" %}
{% block content %}
<section>
    <h1>{{ category.name }}</h1>
    ...
    <div>
        {% if posts and posts.size > 0 %}
            {% for post in posts %}
                ...
            {% endfor %}
        {% endif %}
    </div>
    {% render "custom-fields", fields: category.customFields %}
    {% render "components/common/pagination", basePath: categoryPath, hasPrev: hasPrev, hasNext: hasNext, prevPage: prevPage, nextPage: nextPage %}
</section>
{% endblock %}