{% layout "layout" %}
{% block content %}
<section>
    <h1>...</h1>
    <div>
        {% if posts and posts.size > 0 %}
            {% for post in posts %}
                <article>
                    <h2><a href="/blog/{{ post.slug }}">{{ post.title }}</a></h2>
                    ...
                </article>
            {% endfor %}
        {% endif %}
    </div>
    {% if hasPrev or hasNext %}
        {% render "components/common/pagination", basePath: "/blog", hasPrev: hasPrev, hasNext: hasNext, prevPage: prevPage, nextPage: nextPage %}
    {% endif %}
</section>
{% endblock %}